                sys.exit()
            snake.handle_event(event)
        snake.move()
        collision_handler.check_collisions()
        score_display.update_score(snake.length)
        screen.fill((0, 0, 0))
        game_board.draw(screen)
        snake.draw(screen)
        food.draw(screen)
