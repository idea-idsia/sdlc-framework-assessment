        snake.move()
        snake.draw(screen)
        food.draw(screen)
        score_display.update_score(snake.length)
        score_display.display_score(screen)
        if collision_handler.check_collisions():
            game_over_condition.check_game_over(screen)
        pygame.display.flip()
        clock.tick(10)
    pygame.quit()
if __name__ == "__main__":
    main()
