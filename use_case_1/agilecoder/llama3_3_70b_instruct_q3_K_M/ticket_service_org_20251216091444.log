            self.screen.fill((0, 0, 0))
            self.screen.blit(text, (self.game_board.grid_size * self.game_board.cell_size // 2 - text.get_width() // 2, self.game_board.grid_size * self.game_board.cell_size // 2 - text.get_height() // 2))
