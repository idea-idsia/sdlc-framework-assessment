    '''
    def generate_new_food(self, snake):
        while True:
            new_pos = (random.randint(0, 780) // 20 * 20, random.randint(0, 580) // 20 * 20)
            if new_pos not in snake.body:
                return new_pos
    '''
    Draws the food on the screen.
