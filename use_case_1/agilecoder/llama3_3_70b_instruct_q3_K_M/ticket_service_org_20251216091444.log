import random
import pygame
'''
This class represents the food in the game.
'''
class Food:
    def __init__(self, size, snake):
        self.size = size
        self.snake = snake
        self.pos = self.set_new_pos()
    '''
    Sets a new position for the food that is not on the snake.
    '''
    def set_new_pos(self):
        while True:
            x = random.randint(0, 780) // 20 * 20
            y = random.randint(0, 580) // 20 * 20
            if (x, y) not in self.snake.body:
                return (x, y)
    '''
    Draws the food on the screen.
    '''
    def draw(self, screen):
        pygame.draw.rect(screen, (255, 0, 0), (self.pos[0], self.pos[1], self.size, self.size))
    '''
    Generates new food position after it has been eaten.
    '''
    def generate_new_food(self):
        self.pos = self.set_new_pos()
