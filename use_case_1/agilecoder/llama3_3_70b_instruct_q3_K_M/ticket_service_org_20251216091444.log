            snake.body[-1][1] < 0 or snake.body[-1][1] >= game_board.screen_height or
            snake.body[-1] in snake.body[:-1]):
            game_over_condition.check_game_over(screen)
        pygame.display.flip()
        clock.tick(10)
if __name__ == "__main__":
    main()
