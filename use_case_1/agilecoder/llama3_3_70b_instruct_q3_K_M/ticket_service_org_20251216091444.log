import pygame
'''
This module handles the score display.
'''
class ScoreDisplay:
    def __init__(self):
        self.score = 0
    def update_score(self, length):
        self.score = length - 3
    def display_score(self, screen):
        font = pygame.font.Font(None, 36)
        text = font.render(f'Score: {self.score}', True, (255, 255, 255))
        screen.blit(text, (10, 10))
