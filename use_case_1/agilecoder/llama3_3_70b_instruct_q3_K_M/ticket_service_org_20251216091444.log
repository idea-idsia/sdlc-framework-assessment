        font = pygame.font.Font(None, 36)
        text = font.render('Game Over', True, (255, 255, 255))
        screen.blit(text, (self.game_board.screen_width // 2 - 75, self.game_board.screen_height // 2))
        pygame.display.flip()
        pygame.time.wait(2000)
        self.reset_game()
