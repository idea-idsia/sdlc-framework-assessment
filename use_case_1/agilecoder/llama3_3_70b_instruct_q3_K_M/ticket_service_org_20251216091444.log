        screen.blit(text, (self.game_board.screen_width // 2 - 120, self.game_board.screen_height // 2 - 36))
        pygame.display.flip()
        pygame.time.wait(2000)
        self.snake.body = [(200, 200), (220, 200), (240, 200)]
        self.snake.length = 3
