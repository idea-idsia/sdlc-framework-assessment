        snake.move()
        food.generate_new_food(snake)
        collision_handler.check_collisions()
        score_display.update_score(snake.length)
        score_display.display_score(screen)
        game_over_condition.check_game_over()
        pygame.display.flip()
        clock.tick(10)
    pygame.quit()

if __name__ == "__main__":
    main()
