def main():
    pygame.init()
    screen = pygame.display.set_mode((800, 600))
    clock = pygame.time.Clock()
    game_board = GameBoard()
    snake = Snake()
    food = Food(20, snake)
    collision_handler = CollisionHandler(snake, game_board, food)
    score_display = ScoreDisplay()
