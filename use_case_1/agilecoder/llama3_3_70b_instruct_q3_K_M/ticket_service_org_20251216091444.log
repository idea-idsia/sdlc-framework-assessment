        self.snake.body = [(200, 200), (220, 200), (240, 200)]
        self.snake.length = 3
        return (200, 200)
    '''
    Draws the food on the screen.
    '''
    def draw(self, screen):
        pygame.draw.rect(screen, (255, 0, 0), (self.pos[0], self.pos[1], self.size, self.size))
