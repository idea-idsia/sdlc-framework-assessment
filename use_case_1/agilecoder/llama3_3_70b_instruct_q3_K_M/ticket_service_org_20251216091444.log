        pygame.display.flip()
        waiting = True
        while waiting:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()  
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_SPACE:
                        self.snake.body = [(200, 200), (220, 200), (240, 200)]
                        self.snake.length = 3
                        self.food.pos = self.food.generate_new_food()
