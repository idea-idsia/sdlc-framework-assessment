    def check_game_over(self, screen):
        font = pygame.font.Font(None, 72)
        text = font.render('Game Over', True, (255, 255, 255))
        screen.blit(text, (self.game_board.screen_width // 2 - 120, self.game_board.screen_height // 2 - 36))
