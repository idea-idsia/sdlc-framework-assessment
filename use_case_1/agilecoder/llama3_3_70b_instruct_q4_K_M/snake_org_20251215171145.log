    def check_food_collision(self):
        """
        Check for collisions between the snake's head and the food.
        Returns:
            bool: True if a collision is detected, False otherwise.
        """
        head_x, head_y = self.snake.body[-1]
        if (self.food.x, self.food.y) == (head_x, head_y):
            return True
        return False

    def draw_snake(self, screen):
        """
        Draw the snake on the game board.
        Args:
            screen: The Pygame screen object.
        """
        for pos in self.snake.body:
            pygame.draw.rect(screen, (0, 255, 0), (pos[0], pos[1], self.block_size, self.block_size))

    def draw_food(self, screen):
        """
        Draw the food on the game board.
        Args:
            screen: The Pygame screen object.
        """
        pygame.draw.rect(screen, (255, 0, 0), (self.food.x, self.food.y, self.block_size, self.block_size))

    def draw_score(self, screen):
        """
        Draw the current score on the game board.
        Args:
            screen: The Pygame screen object.
        """
        font = pygame.font.Font(None, 36)
        text = font.render(f"Score: {self.score}", True, (0, 0, 0))
        screen.blit(text, (10, 10))

    def game_over(self, screen):
        """
        Display the game over message and allow the player to restart.
        Args:
            screen: The Pygame screen object.
        """
        font = pygame.font.Font(None, 72)
        text = font.render("Game Over", True, (0, 0, 0))
        screen.fill((255, 255, 255))
        screen.blit(text, (300, 250))
        font = pygame.font.Font(None, 36)
        text = font.render("Press space to restart", True, (0, 0, 0))
        screen.blit(text, (320, 350))
