# Python
'''
This module contains the Snake class.
'''

class Snake:
    def __init__(self):
        self.body = [(200, 200), (220, 200), (240, 200)]
        self.direction = 'RIGHT'

    def move(self):
        """
        Move the snake based on its current direction.
        """
        head_x, head_y = self.body[-1]
        if self.direction == 'UP':
            new_head = (head_x, head_y - 20)
        elif self.direction == 'DOWN':
            new_head = (head_x, head_y + 20)
        elif self.direction == 'LEFT':
            new_head = (head_x - 20, head_y)
        elif self.direction == 'RIGHT':
            new_head = (head_x + 20, head_y)
        self.body.append(new_head)
        self.body.pop(0)

    def change_direction(self, direction):
        """
        Change the snake's direction.
        Args:
            direction: The new direction ('UP', 'DOWN', 'LEFT', or 'RIGHT').
        """
        if (self.direction == 'UP' and direction != 'DOWN') or \
           (self.direction == 'DOWN' and direction != 'UP') or \
           (self.direction == 'LEFT' and direction != 'RIGHT') or \
           (self.direction == 'RIGHT' and direction != 'LEFT'):
            self.direction = direction

    def grow(self):
        """
        Grow the snake by adding a new segment to its body.
        """
        self.body.insert(0, self.body[0])
