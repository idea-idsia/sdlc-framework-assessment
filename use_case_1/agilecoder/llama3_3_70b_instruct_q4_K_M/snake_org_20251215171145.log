        pygame.quit()
        return
    main_menu = MainMenu(screen)
    difficulty = None
    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return
            difficulty = main_menu.handle_event(event)
            if difficulty is not None:
                break
        main_menu.render()
    game = Game(screen, difficulty)
    game.run()
if __name__ == "__main__":
    main()
