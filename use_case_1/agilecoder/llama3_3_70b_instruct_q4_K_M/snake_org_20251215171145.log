    def collides_with_self(self):
        head = self.body[-1]
        for pos in self.body[:-1]:
            if pos == head:
                return True
        return False
    def eats_food(self, food):
        head = self.body[-1]
        return (head[0] == food.position[0] and
                head[1] == food.position[1])
    def grow(self):
        self.body.insert(0, self.body[0])
