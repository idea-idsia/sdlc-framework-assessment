import random
class Food:
    def __init__(self):
        """
        Initialize the food with a starting position.
        """
        self.position = (400, 300)
    def generate_new_position(self, snake_body):
        while True:
            x = random.randint(0, 39) * 20
            y = random.randint(0, 29) * 20
            if (x, y) not in snake_body:
                self.position = (x, y)
