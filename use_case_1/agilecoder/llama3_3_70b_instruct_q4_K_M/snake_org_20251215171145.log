        screen = pygame.display.set_mode((screen_width, screen_height))
    except Exception as e:
        print(f"Failed to set up display mode: {e}")
        return
    clock = pygame.time.Clock()
    game = Game(screen)
    game.run()
    pygame.quit()
if __name__ == "__main__":
    main()
