import pygame
import random
class Food:
    def __init__(self):
        self.x = random.randint(0, 39) * 20
        self.y = random.randint(0, 29) * 20
    def generate_new_position(self, snake_body):
        while (self.x, self.y) in snake_body:
            self.x = random.randint(0, 39) * 20
            self.y = random.randint(0, 29) * 20
