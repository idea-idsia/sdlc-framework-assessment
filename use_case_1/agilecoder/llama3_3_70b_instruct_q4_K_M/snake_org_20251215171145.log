import pygame
import random

class Food:
    def __init__(self):
        """
        Initialize the food with a random position.
        """
        self.position = (0, 0)
        self.generate_new_position([])

    def generate_new_position(self, snake_body):
        while True:
            x = random.randint(0, 39) * 20
            y = random.randint(0, 29) * 20
            if (x, y) not in snake_body:
                self.position = (x, y)
                break
