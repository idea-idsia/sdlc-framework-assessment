    while True:
        x = random.randint(0, GRID_WIDTH - 1)
        y = random.randint(0, GRID_HEIGHT - 1)

        if board[y][x] == ' ':
            return (y, x)
```

$CODE

### Step 5: Handle Collisions and Grow Snake

Now let's handle collisions and ensure the snake grows when it eats food.

```python
$FILENAME
```python
'''
Detect collisions and update game state.
'''
$DOCSTRING
```
```python
def check_collision(snake_direction, new_head_position):
    return any(
        (new_head_position[0], new_head_position[1]) == tail_position
        for tail_position in [(INITIAL_Y - 1, INITIAL_X), (INITIAL_Y + 1, INITIAL_X),
                              (INITIAL_Y, INITIAL_X - 1), (INITIAL_Y, INITIAL_X + 1)]
    )

def grow_snake(new_head_position, board):
    if not check_collision(snake_direction, new_head_position):
        return

    # Add the food eaten to the snake's body
    x, y = generate_food(board)
    board[y][x] = BODY_PART
```

$CODE

