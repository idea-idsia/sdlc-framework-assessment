```python
'''
This program implements a snake game.
- Creates a grid-based game board.
- Initializes the snake with initial length and starting position.
- Handles arrow key controls for movement.
- Generates food at random positions.
- Detects collisions and updates accordingly.
- Displays the score and game status.
'''
import time
import random
class SnakeGame:
    def __init__(self, grid_size=10):
        self.grid_size = grid_size
        self.snake_head = [(grid_size // 2, grid_size // 2)]
        self.snake_body = [list(self.snake_head[0])]
        self.direction = 'right'
        self.score = 0
    def draw_board(self):
        print("+" + "-" * (self.grid_size - 1) + "+")
        for y in range(self.grid_size):
            row = "|"
            for x in range(self.grid_size):
                if (x, y) == tuple(self.snake_head[0]):
                    row += "o" + "|"
                elif any((nx, ny) == (x, y) for nx, ny in self.snake_body):
                    row += "O" + "|"
                else:
                    row += " " + "|"
            print(row)
        print("+" + "-" * (self.grid_size - 1) + "+")
    def move_snake(self):
        head = tuple(self.snake_head[0])
        new_head = self.get_new_head(head, self.direction)
        # Check for collisions
        if not (0 <= new_head[0] < self.grid_size and 0 <= new_head[1] < self.grid_size):
            return False
        if any(new_head == pos for pos in self.snake_body[:-1]):
            return False
        self.snake_head.insert(0, new_head)
        if (new_head != tuple(self.snake_body[-1])):
            self.snake_body.append(tuple(self.snake_head.pop()))
        # Generate food
        if head not in self.snake_body:
            while True:
                x = random.randint(0, self.grid_size - 1)
                y = random.randint(0, self.grid_size - 1)
                if (x, y) != tuple(head):
                    break
            self.snake_body.append((x, y))
        else:
            self.score += 1
            self.generate_food()
        return True
    def get_new_head(self, head, direction):
        x, y = head
        new_x = x + (direction == 'right') - (direction == 'left')
        new_y = y + (direction == 'down') - (direction == 'up')
        return (new_x, new_y)
    def generate_food(self):
        # Ensure food is not on the snake's body
        while True:
            x = random.randint(0, self.grid_size - 1)
            y = random.randint(0, self.grid_size - 1)
            if (x, y) != tuple(head for head in self.snake_head):
                break
        return (x, y)
    def play_game(self):
        while True:
            key_press = input("Press 'w' for up, 's' for down, 'a' for left, and 'd' for right: ").lower()
            if key_press in ['w', 's', 'a', 'd']:
                self.direction = key_press
                break
        while True:
            if not self.move_snake():
                print("Game Over!")
                return
            self.draw_board()
            time.sleep(0.2)
if __name__ == "__main__":
    game = SnakeGame(grid_size=10)
    game.play_game()
