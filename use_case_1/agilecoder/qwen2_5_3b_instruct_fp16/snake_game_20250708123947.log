'''
Main module for Snake Game.
Handles the entire lifecycle of the game, including board setup,
snake initialization, movement control, food generation, collision handling,
score management, and user interface.
'''

import time
from random import randint

# Define the dimensions of the grid (10x10)
GRID_SIZE = 10
BOARD_WIDTH = GRID_SIZE * 2 + 1
BOARD_HEIGHT = GRID_SIZE * 2 + 1

# Initialize the game board
def initialize_board():
    return [[' ' for _ in range(BOARD_WIDTH)] for _ in range(BOARD_HEIGHT)]

# Draw the current state of the grid to the screen
def draw_board(board):
    print('\n'.join([' '.join(row) for row in board]))

# Generate a random position on the game board, avoiding the snake's body.
def generate_food(board, snake_segments):
    while True:
        x = randint(1, GRID_SIZE)
        y = randint(1, GRID_SIZE)
        if (x, y) not in snake_segments:
            return f'{x},{y}'

# Update the board with a new segment of the snake.
def update_board(board, head_position):
    # Extend the snake's body
    prev_head_x, prev_head_y = head_position
    for i, (segment_x, segment_y) in enumerate(snake_segments[::-1]):
        if i == 0:
            board[prev_head_y][prev_head_x] = 'O'
        else:
            board[segment_y][segment_x] = 'O'

# Draw the snake and food on the game board.
def draw_snake_and_food(board, snake_segments):
    for x, y in snake_segments[::-1]:
        board[y][x] = 'O'
    return board

# Check if there's a collision with boundaries or itself
def check_collision(snake_segments):
    head_x, head_y = snake_segments[0]
    # Collision with boundaries
    if head_x < 1 or head_x > GRID_SIZE or head_y < 1 or head_y > GRID_SIZE:
        return True

    # Collision with own body
    for segment in snake_segments[1:]:
        if segment == (head_x, head_y):
            return True

    return False

# Main game loop.
def main_game():
    board = initialize_board()
    snake_segments = [(GRID_SIZE // 2, GRID_SIZE // 2)]
    food_position = generate_food(board, snake_segments)
    
    while not check_collision(snake_segments):
        draw_board(draw_snake_and_food(board, snake_segments))
        
        # Update the game based on user input
        move_direction = input("Enter direction (w/a/s/d): ").lower()
        if move_direction == 'w':
            head_position = (snake_segments[0][0], snake_segments[0][1] - 1)
        elif move_direction == 'a':
            head_position = (snake_segments[0][0] - 1, snake_segments[0][1])
        elif move_direction == 's':
            head_position = (snake_segments[0][0], snake_segments[0][1] + 1)
        elif move_direction == 'd':
            head_position = (snake_segments[0][0] + 1, snake_segments[0][1])
        
        # Check if the new position is valid
        if check_collision(snake_segments + [head_position]):
            print("Game Over!")
            break
        
        # Update snake's body and generate food.
        update_board(board, head_position)
        board = draw_snake_and_food(board, snake_segments)
        
        # Generate new food if necessary.
        snake_segments.append(head_position)

# Start the game
if __name__ == "__main__":
    main_game()
```

