'''
KeyHandler class to handle user input and control snake movement.
'''
import pygame

class KeyHandler:
    def __init__(self):
        self.snake_directions = [(pygame.K_UP, 'UP'), (pygame.K_DOWN, 'DOWN'),
                                 (pygame.K_LEFT, 'LEFT'), (pygame.K_RIGHT, 'RIGHT')]
    
    def handle_input(self, event):
        if event.type == pygame.KEYDOWN:
            for direction in self.snake_directions:
                if event.key == direction[0] and event.key != self.snake_directions[-1][0]:
                    return True
        return False
