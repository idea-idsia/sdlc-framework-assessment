        for i in range(len(self.board)):
            for j in range(len(self.board[0])):
                if self.board[i][j] == '*':
                    return True
        return False

    def detect_food(self):
        food_found = False
        for i in range(len(self.board) - 1):
            for j in range(len(self.board[0]) - 1):
