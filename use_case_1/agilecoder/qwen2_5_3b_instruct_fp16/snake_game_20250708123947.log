                    print('~', end=' ')
                else:
                    print(' ', end=' ')
            print()
    def handle_key_press(self, key):
        # Key bindings: w/a/s/d for up/left/down/right
        if key == 'w' and not self.direction[1] == 0:  # Up
            return (0, -1)
        elif key == 's' and not self.direction[1] == -1:
            return (0, 1)  # Down
        elif key == 'a' and not self.direction[0] == 1:
            return (-1, 0)  # Left
        elif key == 'd' and not self.direction[0] == -1:
            return (1, 0)  # Right
        else:
            return self.direction
    def game_over(self):
        print("Game Over!")
        time.sleep(2)
        restart = input('Press any key to start again or Q to quit: ')
        if restart.lower() != 'q':
            main()
def main():
    gb = GameBoard()
    while True:
        try:
            gb.draw_board()
            game_over = False
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    raise Exception("User Quit")
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:  # Escape key to quit
                        raise KeyboardInterrupt
                    else:
                        gb.direction = gb.handle_key_press(event.unicode)
            try:
                gb.move_snake()
                if gb.snake[0] == gb.food:
                    gb.food = gb.spawn_food()
            except Exception as e:
                game_over = True
        except (KeyboardInterrupt, EOFError):
            raise KeyboardInterrupt
        finally:
            time.sleep(0.1)
            if game_over:
                break
    main()
if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("Exiting the game.")
