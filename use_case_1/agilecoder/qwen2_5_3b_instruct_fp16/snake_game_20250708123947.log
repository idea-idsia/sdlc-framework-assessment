```python
'''
Snake Game in Python
The game displays a grid-based 10x10 game board, 
initially places a snake at (5, 5), generates random food,
and allows arrow key controls for movement. Upon collisions or end of the game,
game over messages are displayed and scoring is managed.
'''
import random
from enum import Enum
class Direction(Enum):
    RIGHT = '>'
    LEFT = '<'
    UP = '^'
    DOWN = 'v'
def draw_board(board, snake_position, food_position, direction):
    print('+' + ('-' * 10) + '+')
    for row in board:
        line = '|'
        for cell in row:
            if (cell[0], cell[1]) == snake_position:
                line += Direction(direction).value
            elif (cell[0], cell[1]) == food_position:
                line += 'F'
            else:
                line += '#'
        print(line + '|')
    print('+' + ('-' * 10) + '+')
def generate_food(snake_positions):
    available_cells = [(x, y) for x in range(10) for y in range(10)]
    for pos in snake_positions:
        if pos in available_cells:
            available_cells.remove(pos)
    food_position = random.choice(available_cells)
    return food_position
def main():
    board = [['#' for _ in range(10)] for _ in range(10)]
    initial_snake = [(5, 5), (4, 5), (3, 5)]
    snake_direction = Direction.RIGHT
    snake_positions = initial_snake[:]
    def move(direction):
        head_x, head_y = initial_snake[0]
        if direction == 'RIGHT':
            new_head = (head_x + 1, head_y)
        elif direction == 'LEFT':
            new_head = (head_x - 1, head_y)
        elif direction == 'UP':
            new_head = (head_x, head_y - 1)
        else:
            new_head = (head_x, head_y + 1)
        if new_head not in initial_snake and new_head != food_position:
            del snake_positions[-1]
            snake_positions.insert(0, new_head)
    # Initial setup
    draw_board(board, initial_snake, generate_food(initial_snake), Direction(snake_direction).value)
    while True:
        user_input = input("Move (left/right/up/down): ").upper()
        if user_input in ['LEFT', 'RIGHT', 'UP', 'DOWN']:
            move(user_input)
            draw_board(board, snake_positions, generate_food(snake_positions), Direction(snake_direction).value)
            for pos in initial_snake:
                board[pos[0]][pos[1]] = '#'
            for head_x, head_y in snake_positions:
                if (head_x, head_y) == food_position:
                    snake_positions.append((head_x, head_y))
                    draw_board(board, snake_positions, generate_food(snake_positions), Direction(snake_direction).value)
                    print("You ate the food! Score increased by 10.")
                    break
                else:
                    board[head_x][head_y] = Direction(snake_direction).value
            if (snake_positions[-1] in initial_snake or 
                snake_positions[-1][0] < 0 or snake_positions[-1][0] > 9 or 
                snake_positions[-1][1] < 0 or snake_positions[-1][1] > 9):
                print("Game Over! You hit the boundary.")
                break
        else:
            print("Invalid input. Please use 'left', 'right', 'up', or 'down'.")
if __name__ == "__main__":
    main()
