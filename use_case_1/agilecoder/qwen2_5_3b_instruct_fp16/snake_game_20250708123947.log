import random

class GameBoard:
    def __init__(self):
        self.board = [['X' for _ in range(30)] for _ in range(30)]
        self.snake = Snake()
        self.food_generator = FoodGenerator()

    @property
    def width(self):
        return len(self.board[0])

    @property
    def height(self):
        return len(self.board)

    def render_board(self, screen):
        for row_index, row in enumerate(self.board):
            for col_index, col in enumerate(row):
                if col == 'X':
                    pygame.draw.rect(screen, (255, 0, 0), [col_index * 25, row_index * 25, 25, 25])
                else:
                    pygame.draw.rect(screen, (0, 128, 128), [col_index * 25, row_index * 25, 25, 25])

    def place_food(self):
        food_x = random.randint(0, self.width - 1)
        food_y = random.randint(0, self.height - 1)
        if self.board[food_x][food_y] == 'X':
            return self.place_food()
        else:
            self.board[food_x][food_y] = '@'
            return (food_x, food_y)

def main():
    game_board = GameBoard()

if __name__ == "__main__":
    main()
