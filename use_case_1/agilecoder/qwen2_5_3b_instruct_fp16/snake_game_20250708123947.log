```python
snake_init.py
```python
'''
This file initializes the snake and its movement.
'''

SNAKE_LENGTH = 3
STARTING_POSITION = (5, 5)
INITIAL_DIRECTION = 'right'

def initialize_snake():
    '''Initialize the snake with initial length and starting position.'''
    global snake_positions
    snake_positions = [(i, j) for i in range(SNAKE_LENGTH)]
    # Assuming coordinates are represented as tuples (x, y)
    snake_positions = [(i + STARTING_POSITION[0], j + STARTING_POSITION[1]) for i, j in snake_positions]
    
    return snake_positions

snake_init()
```
