'''
This program creates a snake game using Python.
The game includes features such as:
- A grid-based game board,
- Initialization of the snake on the board,
- Continuous movement controlled by arrow keys,
- Random food generation and collision detection,
- Growth upon eating food, 
- Score tracking,
- Game over conditions, and
- User-friendly graphics and animations.
Dependencies: None (Built-in Python libraries are used)
'''
import random
def initialize_game():
    # Define game board dimensions
    board_width = 10
    board_height = 10
    # Initialize snake position and direction
    snake_body = [(2, 2), (2, 3)]
    snake_direction = 'right'
    return board_width, board_height, snake_body, snake_direction
def generate_food(board_width, board_height):
    while True:
        x = random.randint(0, board_width - 1)
        y = random.randint(0, board_height - 1)
        if (x, y) not in initial_snake_body:
            return x, y
def update_board(board, snake_body):
    clear_screen()
    for row in range(board_height):
        for col in range(board_width):
            if (row, col) in snake_body:
                print('O', end=' ')
            elif (row, col) == start_position:
                print('@', end=' ')
            else:
                print('.', end=' ')
        print()
    print()
def clear_screen():
    # Placeholder for clearing the screen
    pass
# Initialize game variables and board
board_width, board_height, initial_snake_body, snake_direction = initialize_game()
start_position = initial_snake_body[0]
# Game loop
while True:
    update_board(board, initial_snake_body)
    new_head = move_snake(snake_direction)
    if new_head in initial_snake_body or not is_valid_move(new_head, board_width, board_height):
        print('Game Over!')
        break
    # Check for food consumption
    if new_head == generate_food(board_width, board_height):
        snake_length += 1
        continue
    # Move the existing body segments forward
    initial_snake_body = [(head_x, head_y)] + initial_snake_body[:-1]
    direction_change = input("Enter 'w' to go up, 's' to go down, 'a' to go left, or 'd' to go right: ")
    if direction_change == 'w':
        snake_direction = 'up'
    elif direction_change == 's':
        snake_direction = 'down'
    elif direction_change == 'a':
        snake_direction = 'left'
    elif direction_change == 'd':
        snake_direction = 'right'
print('Final Score:', snake_length)
def move_snake(direction):
    x, y = start_position
    if direction == 'up':
        return (x - 1, y)
    elif direction == 'down':
        return (x + 1, y)
    elif direction == 'left':
        return (x, y - 1)
    elif direction == 'right':
        return (x, y + 1)
def is_valid_move(head_position, board_width, board_height):
    x, y = head_position
    return 0 <= x < board_width and 0 <= y < board_height
# Placeholder function for generating food and checking game over conditions
snake_length = len(initial_snake_body)
