'''
Handle food generation and collision detection.
'''

def remove_tail():
    snake_body.pop()

def update_game_board(snake_head, board):
    # Clear the screen with a grid pattern.
    print(" " * 40)
    
    for y in range(board[1]):
        if y == 0 or (y > 0 and y % 2 == 0): 
            print('-', end='')
        else:
            for x in range(board[0]):  
                if [x, y] not in snake_head + food_position: 
                    print('.', end='')  
                elif [x, y] == food_position: 
                    print('F', end=' ')
                else: 
                    print('S', end='')
            print()
    print(" " * 40)

def check_collision(snake_body):
    global is_running
    head = snake_head[0]
    if (head[0] < 0 or head[0] >= board[0] or head[1] < 0 or head[1] >= board[1]):
        print("Game Over!")
        pygame.quit()
        quit()

def check_snake_body_collision(snake_body):
    global is_running
    for segment in snake_body:
        if segment == snake_head[1:]:
            is_running = False

