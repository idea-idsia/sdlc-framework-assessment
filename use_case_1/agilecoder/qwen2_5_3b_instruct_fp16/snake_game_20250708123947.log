This module implements a Snake game using Python's Pygame library or built-in terminal graphics.
Key functionalities include:
- Displaying the grid-based game board
- Initializing the snake with random starting position and direction
- Handling user input for movement (arrow keys)
- Generating food randomly on the board
- Detecting collisions with boundaries, body, or food
- Updating the score dynamically
- Ending the game on collision
'''
import random
import os
# Dimensions of the game board
BOARD_WIDTH = 10
BOARD_HEIGHT = 10
# Snake initial state
SNAKE_LENGTH = 3
STARTING_POSITION = [4, 5]
SNAKE_DIRECTION = "right"
def display_board(board):
    # Function to print ASCII art representing the game board and snake.
    os.system('cls' if os.name == 'nt' else 'clear')
    for y in range(BOARD_HEIGHT):
        for x in range(BOARD_WIDTH):
            pos = (x, y)
            if pos in STARTING_POSITION:
                print("O", end="")
            elif pos in SNAKE_BODY:
                print("^", end="")
            elif board[pos] == "food":
                print("*", end="")
            else:
                print(" ", end="")
        print()
def generate_food(board):
    # Function to place food randomly on the game board.
    while True:
        x = random.randint(0, BOARD_WIDTH - 1)
        y = random.randint(0, BOARD_HEIGHT - 1)
        if (x, y) not in STARTING_POSITION and (x, y) not in SNAKE_BODY and board[(x, y)] != "food":
            return x, y
def check_collision(board, head):
    # Check collision with boundaries
    if head[0] < 0 or head[0] >= BOARD_WIDTH or head[1] < 0 or head[1] >= BOARD_HEIGHT:
        return True
    # Check collision with snake's body
    for part in SNAKE_BODY[:-1]:
        if part == head:
            return True
    return False
def update_snake(head, direction):
    new_head = [head[0], head[1]]
    if direction == "up":
        new_head[1] -= 1
    elif direction == "down":
        new_head[1] += 1
    elif direction == "left":
        new_head[0] -= 1
    elif direction == "right":
        new_head[0] += 1
    return tuple(new_head)
def main():
    # Initialize the board and snake
    SNAKE_BODY = [tuple(pos) for pos in STARTING_POSITION]
    game_board = {pos: "-" for y in range(BOARD_HEIGHT) for x in range(BOARD_WIDTH)}
    food_x, food_y = generate_food(game_board)
    game_board[food_x, food_y] = "food"
    score = 0
    move_count = 0
    while True:
        display_board(game_board)
