'''
GameBoard class to represent the game board with a grid structure.
'''
import random

class GameBoard:
    def __init__(self, size=10):
        self.size = size
        self.grid = [[' ' for _ in range(size)] for _ in range(size)]
    
    def place_snake(self, head_position=(random.randint(1, 9), random.randint(1, 9))):
        # Place initial snake segments at the given position
        return [(head_position[0], head_position[1] - i) for i in range(3, 0, -1)]
    
    def place_food(self):
        food_position = (random.randint(2, self.size-2), random.randint(2, self.size-2))
        while food_position in [segment for segment in self.place_snake()]:
            food_position = (random.randint(2, self.size-2), random.randint(2, self.size-2))
        return food_position
    
    def draw(self):
        for row in self.grid:
            print(' '.join(row))
