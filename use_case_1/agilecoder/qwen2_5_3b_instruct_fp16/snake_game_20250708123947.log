class GameBoard:
    def __init__(self, width=10, height=10):
        self.width = width
        self.height = height
        self.board = [[' ' for _ in range(width)] for _ in range(height)]
        self.snake = [(random.randint(2, width-3), random.randint(2, height-3))]
        self.food = self.spawn_food()
        self.direction = (0, 1)  # Moving right initially
    def spawn_food(self):
        x, y = random.randint(2, self.width - 3), random.randint(2, self.height - 3)
        while (x, y) in self.snake:
            x, y = random.randint(2, self.width - 3), random.randint(2, self.height - 3)
        return (x, y)
    def move_snake(self):
        head_x, head_y = self.snake[0]
        new_head = ((head_x + self.direction[0]) % self.width,
                    (head_y + self.direction[1]) % self.height)
        if new_head in self.snake:
            raise Exception("Game Over: Snake ate itself!")
        self.snake.insert(0, new_head)
    def draw_board(self):
        for y in range(self.height):
            for x in range(self.width):
                if (x, y) == tuple(self.snake[-1]):
                    print('O', end=' ')
                elif (x, y) == self.food:
                    print('~', end=' ')
                else:
                    print(' ', end=' ')
            print()
    def handle_key_press(self, key):
        # Key bindings: w/a/s/d for up/left/down/right
        if key == 'w' and not self.direction[1] == 0:  # Up
            return (0, -1)
        elif key == 's' and not self.direction[1] == -1:
            return (0, 1)  # Down
        elif key == 'a' and not self.direction[0] == 1:
            return (-1, 0)  # Left
        elif key == 'd' and not self.direction[0] == -1:
            return (1, 0)  # Right
        else:
            return self.direction
    def game_over(self):
        print("Game Over!")
        time.sleep(2)
        restart = input('Press any key to start again or Q to quit: ')
        if restart.lower() != 'q':
            main()
def main():
    gb = GameBoard()
    while True:
        try:
            gb.draw_board()
            game_over = False
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    raise Exception("User Quit")
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:  # Escape key to quit
