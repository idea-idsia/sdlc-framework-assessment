from typing import List, Tuple
def handle_collision(snake: si.Snake) -> bool:
    """Check for any collision."""
    if any([pos[0] < 0 or pos[0] >= GRID_SIZE or pos[1] < 0 or pos[1] >= GRID_SIZE for pos in snake.body]):
