import pygame

class AnimationsForSnakeMovement:
    def __init__(self, board):
        self.board = board
        self.snake_segments = []
    
    def update_snake(self):
        head_position = (self.board.snake_segments[0][0], self.board.snake_segments[0][1])
        if head_position != self.snake_segments[-1]:
            new_segment = (head_position[0] - 1, head_position[1])
            self.snake_segments.append(new_segment)
    
    def draw_snake(self):
        for segment in self.snake_segments:
            x, y = segment
            print(f"{self.board.grid[x][y]} ", end="")
        print()
