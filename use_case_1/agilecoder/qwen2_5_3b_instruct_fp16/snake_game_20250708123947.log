```python
def game_board():
    '''
    Creates and displays the game board.
    Grid dimensions are 10x10, using ASCII characters for the grid representation.
    '''
    print("+" + "-" * 28 + "+")
    for i in range(11):
        row = "|"
        for j in range(11):
            if (i == 5 and j == 5) or (j == 0):
                row += "S |"  # Snake starts at the center
            elif j == 9:
                row += "_|"
            else:
                row += " _|"
        print(row)
        print("+" + "-" * 28 + "+")
```

```python
def initialize_snake():
    '''
    Initializes the snake on the game board.
    Snake starts in a specific position with predefined length and direction.
    '''
    global snake
    snake = ["S" + str(i) for i in range(5, 10)]  # Starting at (5,5), length of 5 segments


```python
def move_snake(direction):
    '''
    Moves the snake according to the given direction.
    Continues moving even without user input initially set to right.
    Updates the position on the game board and checks for collisions.
    '''
    global snake
    head = snake[0]
    
    if direction == "RIGHT":
        new_head = [head[0], int(head[1:]) + 1]  # Move one step to the right
    elif direction == "LEFT":
        new_head = [head[0], int(head[1:]) - 1]  # Move one step to the left
    elif direction == "UP":
        new_head = [int(head[0:1]) - 1, head[1:]]  # Move one step upwards
    elif direction == "DOWN":
        new_head = [int(head[0:1]) + 1, head[1:]]  # Move one step downwards
    
    snake.insert(0, str(new_head))  # Insert the new position at the start of the list

```python
def generate_food():
    '''
    Generates food at random positions on the game board.
    Avoids placing food on the snake's body or boundaries.
    '''
    global food_position
    while True:
        x = (random.randint(1, 9))
        y = (random.randint(2, 9))  # Avoiding first and last rows to stay within grid
        if str(x) + str(y) not in snake:
            food_position = "F" + str(x) + str(y)
            break

```python
def check_collision():
    '''
    Checks for collisions between the snake's head, body segments, or with the boundaries.
    Returns True if there is a collision; False otherwise.
    '''
    global game_over
    
    # Check boundary collision
    if (snake[0][0] < 1 or snake[0][0] > 9) or (snake[0][1] < 2 or snake[0][1] > 9):
        game_over = True
        
    # Check body segment collision
    for seg in snake[1:]:
        if head == seg:
            game_over = True

```python
def handle_food_consumption():
    '''
    Increases the length of the snake upon consuming food.
    Removes the consumed food from the board.
    Updates the position and length of the snake.
    '''
    global food_position, score
    
    for i in range(len(snake)):
        if food_position == str(i):
            snake.append(snake[i])  # Append new segment
            del snake[0]  # Remove first element (consumed food)
            score += 1

```python
def display_score():
    '''
    Displays the current game score.
    '''
    print("Score:", score)

```python
game_over = False
score = 0
snake = ["S5", "S6", "S7", "S8", "S9"]
head = snake[0]
food_position = None

initialize_snake()
print("\nGame Start!")
display_score()

while not game_over:
    direction = input("Use arrow keys to move (RIGHT, LEFT, UP, DOWN): ").upper()
    
    if direction in ["RIGHT", "LEFT", "UP", "DOWN"]:
        move_snake(direction)
        
        generate_food()
        check_collision()
        
        if food_position and food_position != head:
            handle_food_consumption()

```python
```

### Summary of Code:
- **game_board**: Defines the grid-based game board.
- **initialize_snake**: Initializes the snake's position on the game board with a length of 5 segments starting at (5,5).
- **move_snake**: Moves the snake according to user input or predefined direction and updates its position.
- **generate_food**: Generates food at random positions ensuring it does not appear on the snake's body or boundaries.
- **check_collision**: Detects collisions between the snake’s head and other segments as well as boundaries and its own body.
- **handle_food_consumption**: Increases the length of the snake when it consumes food by appending a new segment to its position in the list.
- **display_score**: Displays the current score on the screen.

This code satisfies all the requirements specified for creating a Snake Game.

