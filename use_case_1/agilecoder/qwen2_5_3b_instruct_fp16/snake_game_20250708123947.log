import pygame

class GraphicsAndUIDesign:
    def __init__(self):
        self.snake_head = 'S'
        self.snake_body = 'O'
        self.food = 'X'
    
    def draw_snake(self, board):
        for segment in board.snake_segments:
            x, y = segment
            if (x == 1 and y == 1) or (x == 2 and y == 1):
                print(f"{self.snake_head} ", end="")
            else:
                print(f"{self.snake_body} ", end="")
        for row in board.grid:
            print(' '.join(row))
    
    def draw_food(self, board):
        food_position = board.place_food()
        x, y = food_position
        if (x == 1 and y == 1) or (x == 2 and y == 1):
            print(f"{self.food} ", end="")
