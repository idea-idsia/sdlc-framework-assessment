import snake_init
from graphics_and_ui import GameBoard, draw_snake, draw_food

# Initialize game components
snake_positions = snake_init.initialize_snake()
food_position = (random.randint(0, 9), random.randint(0, 9))
game_over = False
direction = INITIAL_DIRECTION

def main():
    global direction, food_position, game_over, snake_positions
    
    # Game loop
    while not game_over:
        food_generation.generate_food()
        collision_handling.detect_collision(snake_head_position)
        draw_snake(snake_positions)
        draw_food(food_position)
        
        if keyboard.is_pressed('left'):
            new_direction = 'left'
        elif keyboard.is_pressed('right'):
            new_direction = 'right'
        elif keyboard.is_pressed('up'):
            new_direction = 'up'
        elif keyboard.is_pressed('down'):
            new_direction = 'down'

        # Update snake position based on initial direction
        if not game_over:
            for i in range(len(snake_positions) - 1, 0, -1):
                snake_positions[i] = (snake_positions[i-1][0], snake_positions[i-1][1])
        
            new_x, new_y = (new_direction == 'left') and (snake_positions[0][0]-1, snake_positions[0][1]) or \
                           (new_direction == 'right') and (snake_positions[0][0]+1, snake_positions[0][1]) or \
                           (new_direction == 'up') and (snake_positions[0][0], snake_positions[0][1]-1) or \
                           (new_direction == 'down') and (snake_positions[0][0], snake_positions[0][1]+1)
            snake_positions[0] = new_x, new_y

        # Check for collision
        if check_collision(snake_head_position):
            game_over = True
    
if __name__ == "__main__":
