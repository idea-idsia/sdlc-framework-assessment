import game_controller
import board
import graphics
import key_handler

class Game:
    def __init__(self):
        self.controller = game_controller.GameController()
        self.key_handler = key_handler.KeyHandler(self.controller)
        self.graphics_manager = graphics.GraphicsManager(self.controller)

    def run_game(self):
        while True:
            if not self.key_handler.handle_input():
                break
            self.graphics_manager.draw_board()

if __name__ == "__main__":
    game = Game()
    game.run_game()
