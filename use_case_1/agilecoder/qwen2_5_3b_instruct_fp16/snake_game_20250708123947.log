import pygame
from game_controller import GameController
class GraphicsManager:
    def __init__(self, controller: GameController):
        self.controller = controller
        pygame.init()
        size = (BOARD_SIZE[0] * 20, BOARD_SIZE[1] * 20)
        self.screen = pygame.display.set_mode(size)
        pygame.display.set_caption('Snake Game')
    def draw_board(self):
        self.screen.fill((0, 0, 0))
        for row_idx in range(BOARD_SIZE[0]):
            for col_idx in range(BOARD_SIZE[1]):
                rect = (col_idx * 20, row_idx * 20, 20, 20)
                pygame.draw.rect(self.screen, (255, 255, 255), rect, 1 if self.controller.board.board[row_idx][col_idx] == ' ' else 3)
        snake_rect = [(rect for pos in self.controller.snake)]
        pygame.draw.rect(self.screen, (0, 255, 0), snake_rect[0], 3)
        pygame.display.flip()
    def run_game(self):
        controller = GameController()
        key_handler = KeyHandler(controller)
        graphics_manager = GraphicsManager(controller)
        running = True
        while running:
            if not key_handler.handle_input():
                running = False
            graphics_manager.draw_board()
        pygame.quit()
