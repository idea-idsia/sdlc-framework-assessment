        return food_position

    def move_snake(self, direction):
        new_head = (self.snake_positions[0][0] + direction[0], 
                    self.snake_positions[0][1] + direction[1])
        
        if not ((new_head[0] < 0 or new_head[0] >= self.grid_size or
