    while True:
        if snake_game.check_game_over():
            break
        
        key = stdscr.getch()
        
        if key not in [KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT]:
            continue
        
        snake_game.direction = key
        food_position = snake_game.generate_food()
        if food_position is None:
