from snake import initialize_snake
from movement import handle_movement
from food import place_food
from collision import detect_collision, detect_food_collision
from growth import grow_snake
from score_display import show_score
from game_over import check_game_over, handle_game_over
def main():
    """
    Main function to run the snake game.
    """
    board, snake_body = initialize_snake()
    direction = 'right'
    while True:
        if detect_collision(board):
            break
        if detect_food_collision(board):
            place_food(board)
            grow_snake(board)
        handle_movement(board, direction)
        show_score(len(snake_body) - 3)  # Adjusted score by initial length
        for row in board:
            print(''.join(row))
        key = input("Press 'a' to move left, 'd' to move right, 'w' to move up, 's' to move down: ").lower()
        if key == 'q':
            break
        elif key in ['a', 'd', 'w', 's']:
            direction = key
    check_game_over(board)
    handle_game_over(len(snake_body) - 3)
if __name__ == "__main__":
