            return True
        return False

    @staticmethod
    def update_snake_position(snake_body, new_head):
        for segment in reversed(range(len(snake_body))):
            if segment == len(snake_body) - 1:
                snake_body[segment] = (new_head)
            else:
                snake_body[segment] = snake_body[segment + 1]
