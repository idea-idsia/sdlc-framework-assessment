'''

import pygame

class ImplementAnimationEffects:
    def __init__(self, surface):
        self.surface = surface
        self.flash_color = (255, 0, 0)
        self.flash_duration = 300
    
    def flash_collision(self, time=1000):
        self.surface.fill((0, 0, 0))
        pygame.time.wait(time)
        pygame.draw.rect(self.surface, self.flash_color, (self.surface.get_width() // 2 - 50, self.surface.get_height() // 2 - 50, 100, 100), border_radius=30)
        pygame.display.flip()
