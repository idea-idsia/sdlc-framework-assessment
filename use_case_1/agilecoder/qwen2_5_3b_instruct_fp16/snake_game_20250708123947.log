'''
Game of Snake in Python.

This program implements a simple snake game where:
1. A player controls a snake using arrow keys to move.
2. The snake grows when it eats food.
3. The game ends if the snake hits the boundaries or itself.
4. A score is displayed based on how long the snake lasts before hitting boundaries or its own body.

The game uses ASCII characters for rendering the snake and food, with a simple grid-based board.
'''

import random

# Global variables
grid_size = 10
board = [[' ' for _ in range(grid_size)] for _ in range(grid_size)]
snake_body = [(4, 5), (3, 5), (2, 5)]
direction = (0, -1)  # Initial direction is down

def draw_board():
    """Draws the game board with snake and food."""
    print("\n".join(["".join(row) for row in board]))
    return None

def get_food_position(snake):
    """Generates a random position not occupied by the snake."""
    while True:
        x, y = (random.randint(0, grid_size - 1), random.randint(0, grid_size - 1))
        if tuple([x, y]) not in snake_body:
            return [x, y]

def move_snake(snake, direction):
    """Moves the snake's head based on its current position and direction."""
    new_head = (snake[0][0] + direction[0], snake[0][1] + direction[1])
    if not is_position_out_of_bounds(new_head) and new_head not in snake_body:
        return [new_head] + snake[:-1]
    else:
        return snake  # Game Over when hitting boundaries or body

def draw_snake(snake):
    """Draws the snake on the board."""
    for x, y in snake:
        board[x][y] = 'S'

def is_position_out_of_bounds(position):
    """Checks if a position is out of the game board bounds."""
    return not (0 <= position[0] < grid_size and 0 <= position[1] < grid_size)

# Initial setup
draw_board()
food_pos = get_food_position(snake_body)
board[food_pos[0]][food_pos[1]] = 'F'

def main():
    score = len(snake_body) - 3  # Subtract 2 for initial body segments and head

    while True:
        draw_board()
        print(f"Score: {score}")

        key = input("Press a to start, q to quit: ").lower()

        if key == 'a':
            new_direction = move_snake(snake_body, direction)
            snake_body = new_direction
            if board[food_pos[0]][food_pos[1]] == 'S':  # Check for collision with food
                score += 1
                food_pos = get_food_position(new_direction)
                board[food_pos[0]][food_pos[1]] = 'F'
        elif key == 'q':
            break

if __name__ == "__main__":
    main()
```

