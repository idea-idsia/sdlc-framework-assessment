        x, y = random.randint(2, self.width - 3), random.randint(2, self.height - 3)
        while (x, y) in self.snake:
            x, y = random.randint(2, self.width - 3), random.randint(2, self.height - 3)
        return (x, y)
    def move_snake(self):
