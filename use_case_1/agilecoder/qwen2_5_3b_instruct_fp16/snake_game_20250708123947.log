def main():
    '''Main function to run the Snake Game'''
    play_game()
def play_game():
    '''Function to handle the gameplay logic of Snake Game'''
    board_size = 10
    snake = [(4, 4)]
    direction = 'right'
    # $DOCSTRING
    print('Welcome to the Snake Game!')
    print(f'Game Board: {board_size}x{board_size}')
    print('Use arrow keys to control the snake. Press spacebar to start.')
    while True:
        game_board(board_size)
        if direction == 'right':
            new_head = (snake[0][0] + 1, snake[0][1])
        elif direction == 'left':
            new_head = (snake[0][0] - 1, snake[0][1])
        elif direction == 'down':
            new_head = (snake[0][0], snake[0][1] + 1)
        else:
            new_head = (snake[0][0], snake[0][1] - 1)
        if new_head in snake or new_head[0] < 0 or new_head[0] >= board_size \
           or new_head[1] < 0 or new_head[1] >= board_size:
            game_over()
            break
        # Check for food
        if new_head == (random.randint(0, board_size - 1), random.randint(0, board_size - 1)):
            snake.append(new_head)
        else:
            last_segment = snake.pop()
        snake.insert(0, new_head)
        time.sleep(0.5)
def game_board(size):
    '''Print the current state of the game board'''
    print('\n' * 2)  # Clear previous output
    for y in range(size):
        row = []
        for x in range(size):
            if (x, y) == snake[0]:
                row.append('X')  # Snake head
            elif (x, y) in snake:
                row.append('+')  # Snake body segment
            else:
                row.append(' ')
        print('|' + '|'.join(row) + '|')
def game_over():
    '''Display the game over message'''
    print('\nGame Over!\n')
    print(f'Score: {len(snake) - 1}')
if __name__ == '__main__':
    main()
