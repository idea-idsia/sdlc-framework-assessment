    init_snake(board)
    
    print_board(board)

    # Initial movement in a specific direction (right) for simplicity
    snake_direction = RIGHT

    while True:
        key_pressed = input("Press 'w' to go up, 's' to go down, 'a' to go left, or 'd' to go right: ")
        
        if key_pressed not in [UP, DOWN, LEFT, RIGHT]:
            continue
        
        new_snake_direction = key_pressed
        snake_direction = new_snake_direction

        if move_snake(snake_direction, board):
            generate_food(board)
            grow_snake(new_snake_position=snake_head_position, board=board)

        print_board(board)

play_game()

$CODE
```

