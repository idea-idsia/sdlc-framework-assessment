    food_position = place_food((GRID_SIZE, GRID_SIZE), food_position)
    if snake[0] == food_position:
        score += 1
        food_position = place_food((GRID_SIZE, GRID_SIZE), food_position)
grow_snake(snake)
game_over(snake)
update_score(snake)
