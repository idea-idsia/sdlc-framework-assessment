    if not is_collision(new_head_position): 
        del snake_positions[-1]
        snake_positions.insert(0, new_head_position)
    return snake_positions
def get_new_head(position: tuple, direction: str) -> tuple:
    x, y = position
    if direction == 'UP':
        return (x, y - 25)
    elif direction == 'DOWN':
        return (x, y + 25)
    elif direction == 'LEFT':
        return (x - 25, y)
    else:  # RIGHT
        return (x + 25, y)
