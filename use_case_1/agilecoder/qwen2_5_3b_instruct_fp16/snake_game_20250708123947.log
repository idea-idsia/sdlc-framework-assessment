'''
This file manages the graphical user interface (GUI) for the snake game.
'''

import pygame

class UserInterface:
    def __init__(self):
        self.screen = None
        self.snake = None
    
    def initialize_screen(self, screen_size=(800, 600)):
        pygame.init()
        self.screen = pygame.display.set_mode(screen_size)
    
    def render_snake(self, snake_positions):
        for position in snake_positions:
            x, y = position
            if (x // 25, y // 25) == (0, 1):  # Top head segment (snake's body is represented as 'X')
                pygame.draw.rect(self.screen, (0, 0, 255), [x * 25, y * 25, 25, 25])
            else:  # Body segments
                pygame.draw.rect(self.screen, (0, 128, 128), [x * 25, y * 25, 25, 25])

    def render_food(self, food_position):
        x, y = food_position
        pygame.draw.rect(self.screen, (255, 0, 0), [x * 25, y * 25, 25, 25])
    
    def update_score(self, score):
        font = pygame.font.Font(None, 36)
        text = font.render(f"Score: {score}", True, (255, 255, 255))
        self.screen.blit(text, [10, 10])

    def render_board(self, screen):
        game_board = GameBoard()
        game_board.render_board(screen)

def main():
    game_interface = UserInterface()
    game_interface.initialize_screen(screen_size=(800, 600))

if __name__ == "__main__":
    main()
