        self.snake.insert(0, new_head)

    def draw_board(self):
        for y in range(self.height):
            for x in range(self.width):
                if (x, y) == tuple(self.snake[-1]):
                    print('O', end=' ')
                elif (x, y) == self.food:
                    print('~', end=' ')
                else:
                    print(' ', end=' ')
            print()

    def handle_key_press(self, key):
        # Key bindings: w/a/s/d for up/left/down/right
        if key == 'w' and not self.direction[1] == 0:  # Up
            return (0, -1)
        elif key == 's' and not self.direction[1] == -1:
            return (0, 1)  # Down
        elif key == 'a' and not self.direction[0] == 1:
            return (-1, 0)  # Left
        elif key == 'd' and not self.direction[0] == -1:
            return (1, 0)  # Right
        else:
            return self.direction

    def game_over(self):
        print("Game Over!")
        time.sleep(2)
        restart = input('Press any key to start again or Q to quit: ')
        if restart.lower() != 'q':
            main()

def main():
    gb = GameBoard()
