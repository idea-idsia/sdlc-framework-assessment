        head_x, head_y = self.body[0]
        if self.direction == 'right': return (head_x + 1, head_y)
        elif self.direction == 'left': return (head_x - 1, head_y)
        elif self.direction == 'up': return (head_x, head_y - 1)
        else: return (head_x, head_y + 1)
