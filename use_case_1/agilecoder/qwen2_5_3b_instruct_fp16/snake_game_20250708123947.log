def generate_food(board_width, board_height):
    while True:
        x = random.randint(0, board_width - 1)
        y = random.randint(0, board_height - 1)
        if (x, y) not in initial_snake_body:
            return x, y
def update_board(board, snake_body):
    clear_screen()
    for row in range(board_height):
        for col in range(board_width):
            if (row, col) in snake_body:
                print('O', end=' ')
            elif (row, col) == start_position:
                print('@', end=' ')
            else:
                print('.', end=' ')
        print()
    print()
def clear_screen():
    # Placeholder for clearing the screen
    pass
# Initialize game variables and board
