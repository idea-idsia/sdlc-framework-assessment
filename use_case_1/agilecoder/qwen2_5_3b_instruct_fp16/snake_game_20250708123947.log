direction = 'RIGHT'
food_position = place_food((GRID_SIZE, GRID_SIZE), food_position=None)
score = 0
def game_over(snake):
    if is_grid_out_of_boundaries(snake[0], (GRID_SIZE, GRID_SIZE)) or is_collision(snake[0], snake[:-1]):
        print("Game Over")
        display_score(score)
