    head_x, head_y = head
    for segment in body:
        if (head_x - 1, head_y) == segment or (head_x + 1, head_y) == segment or (head_x, head_y - 1) == segment or (head_x, head_y + 1) == segment:
            return True
    return False
def detect_food_collision(head: tuple, food_position: tuple):
    head_x, head_y = head
    if (head_x, head_y) == food_position:
        return True
    return False
