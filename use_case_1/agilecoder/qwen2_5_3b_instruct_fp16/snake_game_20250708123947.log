    """Draw food at the given position using ASCII characters."""
    x, y = food_position
    if (x, y) == snake_head_position:
        print(ASCII_CHARS[4], end='')  # Food eaten
    else:
        print(ASCII_CHARS[2], end='')  # Food
draw_food(food_position)
