def grow_snake(board):
    head_x, head_y = snake_body[0]
    for segment in snake_body[1:]:
        if (head_x - 1, head_y) == segment or (head_x + 1, head_y) == segment or (head_x, head_y - 1) == segment or (head_x, head_y + 1) == segment:
