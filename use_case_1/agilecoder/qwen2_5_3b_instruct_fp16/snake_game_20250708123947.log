```python
import pygame
import sys

# Initialize Pygame
pygame.init()

# Game settings
WIDTH, HEIGHT = 600, 600
GRID_SIZE = 25
SNAKE_SPEED = 10

# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)

# Screen setup
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Snake Game")

def main():
    global snake_pos, direction
    
    clock = pygame.time.Clock()
    
    # Initialize the snake with one segment and starting position
    snake_pos = [(GRID_SIZE // 2) * GRID_SIZE, (GRID_SIZE - GRID_SIZE // 4) * GRID_SIZE]
    direction = "RIGHT"
    
    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
                
        # Move the snake
        move_snake()
        
        # Check for collisions and update screen
        check_collision(snake_pos)
        
        # Draw the game board and snake
        draw_board(snake_pos, food_position)
        
        clock.tick(SNAKE_SPEED)

def move_snake():
    x, y = snake_pos[0]
    
    if direction == "RIGHT":
        new_head = (x + GRID_SIZE, y)
    elif direction == "LEFT":
        new_head = (x - GRID_SIZE, y)
    elif direction == "UP":
        new_head = (x, y - GRID_SIZE)
    else:  # direction == "DOWN"
        new_head = (x, y + GRID_SIZE)
    
    snake_pos.insert(0, new_head)

def check_collision(snake_pos):
    head = snake_pos[0]
    if head in snake_pos[1:]:
        game_over()
    elif head[0] < 0 or head[0] >= WIDTH or head[1] < 0 or head[1] >= HEIGHT:
        game_over()

def draw_board(snake_pos, food_position):
    screen.fill(WHITE)
    
    # Draw snake
    for pos in snake_pos:
        pygame.draw.rect(screen, BLACK, (pos[0], pos[1], GRID_SIZE, GRID_SIZE))
        
    # Draw food if it exists
    if food_position is not None:
        pygame.draw.rect(screen, RED, (food_position[0], food_position[1], GRID_SIZE, GRID_SIZE))
    
    pygame.display.update()

def generate_food(snake_pos):
    global food_position
    
    while True:
        new_food = (random.randint(0, WIDTH // GRID_SIZE - 1) * GRID_SIZE,
                    random.randint(0, HEIGHT // GRID_SIZE - 1) * GRID_SIZE)
        
        if new_food not in snake_pos and new_food != food_position:
            return new_food

def game_over():
    pygame.quit()
    sys.exit()

# Initialize the first position of the food
food_position = generate_food(snake_pos)

if __name__ == "__main__":
    main()
```

