### Final Integration in `main_game.py`

```python
import game_board
from food_generator import FoodGenerator
from collision_detector import CollisionDetector
from score_manager import ScoreManager
from key_handler import KeyHandler
from snake_growth import SnakeGrowthManager
from score_display import ScoreDisplay

def main():
    pygame.init()
    grid_size = 10
    game_board_instance = game_board.GameBoard(grid_size)
    food_generator = FoodGenerator()
    collision_detector = CollisionDetector()
    score_manager = ScoreManager()

    snake_grow_man = SnakeGrowthManager()
    key_handler = KeyHandler()

    running = True
    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

        game_board_instance.current_directions.append(game_board_instance.snake.body[0])
        snake_grow_man.grow_snake(game_board_instance, food_generator.generate_food(game_board_instance))
        
        key_pressed = key_handler.handle_input(game_board_instance)
        if not key_pressed:
            continue
        
        head_x, head_y = game_board_instance.snake.body[0]
        next_position = ((head_x + 1) % grid_size, head_y)
        if not collision_detector.check_valid_move(game_board_instance, next_position):
            print("Game Over!")
            running = False
        else:
            game_board_instance.snake.body.insert(0, next_position)

        score_manager.update_score(score_manager.score, len(snake_grow_man.grow_snake()))

    pygame.quit()

if __name__ == "__main__":
    main()
```

