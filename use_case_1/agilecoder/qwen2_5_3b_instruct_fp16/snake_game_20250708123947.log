        food_position = (random.randint(0, board[0]-1), random.randint(0, board[1]-1))
        if food_position not in snake_head:
            break
    return food_position

def place_snake(snake_body, head_direction):
    # Define possible directions the snake can move: up, down, left, right.
    directions = [(head_direction[0], -head_direction[1]), (-head_direction[0], head_direction[1]),
                  (head_direction[1], head_direction[0]), (-head_direction[1], -head_direction[0])]
    for segment in snake_body:
        next_segment = [segment[0]+directions[random.randint(0, 3)][0],
                        segment[1]+directions[random.randint(0, 3)][1]]
        while next_segment in snake_head or (next_segment[0] < 0 or next_segment[1] < 0 or
                                             next_segment[0] >= board[0] or next_segment[1] >= board[1]):
            # If the new position is out of bounds, choose a new random position.
            next_segment = [segment[0]+directions[random.randint(0, 3)][0],
                            segment[1]+directions[random.randint(0, 3)][1]]
        snake_head.append(next_segment)
```

