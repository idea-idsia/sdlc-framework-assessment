### Step 1: Game Board Initialization

First, we define the grid-based game board and initialize the snake.

```python
snake_game.py
```python
def init_game():
    """
    Initialize the game environment including the grid, snake position, and food.
    """
    import random
    from collections import deque
    
    # Define dimensions of the grid (10x10)
    width, height = 20, 20

    # Create a list to represent the board where each cell is either 'S' for snake or 'F' for food
    board = [[' ']*width for _ in range(height)]
    
    # Initialize the starting position and direction of the snake
    head_pos = (10, 10)  # Start at the center
    body_segments = deque([(head_pos[0]-i, head_pos[1]) for i in range(3)])  # Initial length 3 segments
    
    # Place food randomly, ensuring it's not on the snake's starting position or any segment of the body.
    food_pos = None
    while food_pos is None:
        food_x, food_y = random.randint(0, width-1), random.randint(0, height-1)
        if (food_x, food_y) not in body_segments:
            food_pos = (food_x, food_y)

    return board, head_pos, body_segments, food_pos
```

### Step 2: Snake Movement

Next, we implement the snake's movement based on arrow key controls.

```python
snake_game.py
```python
def move_snake(key):
    """
    Move the snake according to user input.
    Key: 'w', 'a', 's', or 'd' for moving up, left, down, and right respectively.
    """
    new_head = head_pos

    if key == 'w':
        new_head = (head_pos[0], head_pos[1]-1)
    elif key == 'a':
        new_head = (head_pos[0]-1, head_pos[1])
    elif key == 's':
        new_head = (head_pos[0], head_pos[1]+1)
    elif key == 'd':
        new_head = (head_pos[0]+1, head_pos[1])

    # Check if the snake collides with the boundaries
    if not (0 <= new_head[0] < width and 0 <= new_head[1] < height):
        return False

    # Check if the snake collides with itself
    if new_head in body_segments:
        return False
    
    # Move head of the snake to new position and add tail segment to the back
    body_segments.append(new_head)
    body_segments.popleft()

    # Check if snake has eaten food, then generate a new food and increase score
    if new_head == food_pos:
        food_pos = None

        while food_pos is None:
            food_x, food_y = random.randint(0, width-1), random.randint(0, height-1)
            if (food_x, food_y) not in body_segments:
                food_pos = (food_x, food_y)

    return True
```

### Step 3: Food Generation

We ensure the snake doesn't eat its own segments by generating new food positions.

```python
snake_game.py
```python
def generate_food(board):
    """
    Generate a random position for food ensuring it’s not on the snake's body.
    """
    global head_pos, body_segments, food_pos

    # Clear old food if any
    board[head_pos[1]][head_pos[0]] = ' '
    
    while True:
        x, y = random.randint(0, width-1), random.randint(0, height-1)
        if (x, y) not in body_segments:
            break

    # Update the board with new food
    board[y][x] = 'F'
    food_pos = (y, x)

def place_food(board):
    """
    Place initial food on the game board.
    """
    global head_pos, body_segments, food_pos

    if not food_pos:
        generate_food(board)
```

### Step 4: Collision Handling and Score Display

Detect collisions and update the score accordingly.

```python
snake_game.py
```python
def handle_collision():
    """
    Check for collision with boundaries or snake's own segments.
    If a game-over condition is met, return True to exit main loop.
    Otherwise, return False.
    """
    # Collision with board boundary
    if head_pos[0] < 0 or head_pos[0] >= width or head_pos[1] < 0 or head_pos[1] >= height:
        print("Game Over!")
        return True
    
    # Check collision with the snake's own body
    if head_pos in body_segments:
        print("Game Over!")
        return True

    return False

def display_score(score):
    """
    Display current score on screen.
    """
    print(f"Score: {score}")
```

### Step 5: Game Logic and Main Loop

Now, we put everything together in the main game loop.

```python
snake_game.py
```python
import time

def play_snake_game():
    # Initialize variables
    board, head_pos, body_segments, food_pos = init_game()
    score = 0

    while True:
        display_board(board)
        key_pressed = input("Press 'w', 'a', 's', or 'd': ")

        if not move_snake(key_pressed):
            break
        
        place_food(board)
        handle_collision()

        # Update score
        score += 1
        print(f"Score: {score}")
        
        time.sleep(0.2)  # Simulate snake movement delay

def display_board(board):
    """
    Display the board.
    """
    for row in board:
        print(' '.join(row))

if __name__ == "__main__":
    play_snake_game()
```

