from gamedisplay import display_grid, initialize_snake, generate_food
from movement import move_snake
from collision import detect_collisions
from grow import grow_snake
from animations import animate
from score import display_score
def main():
    width = 10
    height = 10
    # Initialize game board and snake
    gamedisplay.board = display_grid(width, height)
    snake_body = initialize_snake(gamedisplay.board)
    while True:
        movement_key = input("Use arrow keys to move the snake. 'r' to restart: ")
        if movement_key == 'r':
            # Reset the board and snake
            gamedisplay.board = display_grid(width, height)
            snake_body = initialize_snake(gamedisplay.board)
            continue
        new_position = move_snake(snake_body, gamedisplay.board)
        food_position = generate_food(gamedisplay.board)
        if (snake_body[-1] == food_position):
            grow_snake(snake_body)
            display_score(len(snake_body) - 5)
            show_food(gamedisplay.board, food_position)
        # Check for collision
        if detect_collisions(snake_body): 
            break
        animate(snake_body)
if __name__ == "__main__":
    main()
