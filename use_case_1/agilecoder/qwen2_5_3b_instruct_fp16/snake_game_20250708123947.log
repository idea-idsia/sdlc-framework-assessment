```
```python
import numpy as np

# Game Board Representation using NumPy
def initialize_board():
    return np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=str)

def print_board(board):
    for y in range(GRID_HEIGHT):
        row = ' '.join(board[y][x] if board[y][x] else '.' for x in range(GRID_WIDTH))
        print(row)
        print('-' * (GRID_WIDTH - 1))

$CODE
```

### Step 3: Initialize Snake

Now, we need to initialize the snake on the game board and define its movement.

```python
$FILENAME
```python
'''
Initialize and move the snake.
'''
$DOCSTRING
```
```python
def init_snake(board):
    # Place the initial position of the snake
    for x in range(INITIAL_X, INITIAL_X + SNAKE_SIZE):
        board[INITIAL_Y][x] = HEAD

def move_snake(snake_direction, board):
    new_head_position = (snake_direction == UP and (INITIAL_Y - 1, INITIAL_X)
                         or snake_direction == DOWN and (INITIAL_Y + 1, INITIAL_X)
                         or snake_direction == LEFT and (INITIAL_Y, INITIAL_X - 1)
                         or snake_direction == RIGHT and (INITIAL_Y, INITIAL_X + 1))

    # Check if the new head position is out of bounds
    if not (0 <= new_head_position[0] < GRID_HEIGHT and 0 <= new_head_position[1] < GRID_WIDTH):
        return False

    # Remove the current tail segment
    initial_tail_x = INITIAL_X + SNAKE_SIZE - 1
    board[INITIAL_Y][initial_tail_x] = '.'

    # Update snake head position to new one and move rest of the body forward
    board[new_head_position[0]][new_head_position[1]] = HEAD

    return True

$CODE
```

