import pygame
from random import randrange
import time
# Initialize Pygame
pygame.init()
# Constants for window dimensions
WIDTH = 400
HEIGHT = 400
LINE_WIDTH = 2
BLOCK_SIZE = WIDTH // 10
FPS = 60
# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)
# Set up display
pygame.display.set_caption('Snake Game')
game_window = pygame.display.set_mode((WIDTH, HEIGHT))
clock = pygame.time.Clock()
def draw_board():
    game_window.fill(WHITE)
    for y in range(0, WIDTH, BLOCK_SIZE):
        pygame.draw.line(game_window, BLACK, (y, 0), (y, HEIGHT))
    for x in range(0, HEIGHT, BLOCK_SIZE):
        pygame.draw.line(game_window, BLACK, (0, x), (WIDTH, x))
def draw_snake(snake_block, snake_list):
    for segment in snake_list:
        pygame.draw.rect(game_window, RED, [segment[0], segment[1], BLOCK_SIZE, BLOCK_SIZE])
# Initialize snake
snake_position = [100, 50]
snake_body = [[100, 50], [90, 50], [80, 50]]
snake_block = BLOCK_SIZE
def game_loop():
    # Game Loop
    direction = 'RIGHT'
    x_change = 0
    y_change = 0
    snake_speed = 15
    game_over = False
    while not game_over:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                game_over = True
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_LEFT and direction != 'RIGHT':
                    x_change, y_change = -BLOCK_SIZE, 0
                    direction = 'LEFT'
                elif event.key == pygame.K_RIGHT and direction != 'LEFT':
                    x_change, y_change = BLOCK_SIZE, 0
                    direction = 'RIGHT'
                elif event.key == pygame.K_UP and direction != 'DOWN':
                    x_change, y_change = 0, -BLOCK_SIZE
                    direction = 'UP'
                elif event.key == pygame.K_DOWN and direction != 'UP':
                    x_change, y_change = 0, BLOCK_SIZE
                    direction = 'DOWN'
        if (snake_position[0] < 0 or snake_position[0] > WIDTH or
            snake_position[1] < 0 or snake_position[1] > HEIGHT):
            game_over = True
        new_snake_position = [snake_position[0] + x_change, snake_position[1] + y_change]
        snake_list.append(new_snake_position)
        if len(snake_body) > snake_speed:
            del snake_body[0]
        snake_body.insert(0, list(snake_position))
        for segment in snake_body[1:]:
            if new_snake_position == segment:
                game_over = True
        game_window.fill(WHITE)
        draw_board()
        draw_snake(BLOCK_SIZE, snake_body)
        pygame.display.update()
        clock.tick(snake_speed)
    # Game Over Screen
    while game_over:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
        game_window.fill(WHITE)
        font = pygame.font.Font(None, 74)
        text1 = font.render('Game Over!', True, BLACK)
        game_window.blit(text1, (WIDTH/3 - 50, HEIGHT/2))
        pygame.display.update()
# Main function
if __name__ == "__main__":
    draw_board()
    while True:
        if len(snake_body) > 30: break
        for i in range(2):
            new_snake_position = [randrange(BLOCK_SIZE, WIDTH - BLOCK_SIZE), randrange(BLOCK_SIZE, HEIGHT - BLOCK_SIZE)]
            while new_snake_position in snake_body[1:]:
                new_snake_position = [randrange(BLOCK_SIZE, WIDTH - BLOCK_SIZE), randrange(BLOCK_SIZE, HEIGHT - BLOCK_SIZE)]
            snake_body.append(new_snake_position)
        game_loop()
    draw_board()
