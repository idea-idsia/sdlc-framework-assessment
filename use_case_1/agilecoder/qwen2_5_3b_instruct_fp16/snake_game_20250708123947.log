```python
def generate_food():
    """Generate a new piece of food at a random position."""
    global food_position
    while True:
        x = random.randint(0, 9)
        y = random.randint(0, 9)
        if (x, y) not in snake_positions + [food_position]:
            food_position = (x, y)
            break
food_position = generate_food()
