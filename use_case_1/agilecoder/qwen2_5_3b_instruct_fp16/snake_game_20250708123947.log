import random
class FoodGenerator:
    def __init__(self):
        self.snake = None
    def generate_food(self, snake: 'Snake') -> Tuple[int]:
        """Generate a new piece of food."""
        while True:
            food_pos = (random.randint(0, GRID_SIZE - 1), random.randint(0, GRID_SIZE - 1))
