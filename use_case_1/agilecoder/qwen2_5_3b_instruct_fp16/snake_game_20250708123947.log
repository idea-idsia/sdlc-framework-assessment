    x, y = start_position
    if direction == 'up':
        return (x - 1, y)
    elif direction == 'down':
        return (x + 1, y)
    elif direction == 'left':
        return (x, y - 1)
    elif direction == 'right':
        return (x, y + 1)
def is_valid_move(head_position, board_width, board_height):
    x, y = head_position
    return 0 <= x < board_width and 0 <= y < board_height
