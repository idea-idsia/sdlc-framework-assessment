        self.board = board.Board(size=BOARD_SIZE)
        self.snake_direction_manager = SnakeDirectionManager()

    def update_board(self, direction):
        try:
            if not self.board.move_snake(direction):
                raise CollisionError('Game Over')
            return True
        except CollisionError as e:
