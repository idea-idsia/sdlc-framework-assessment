import random
from dataclasses import dataclass
from typing import List

@dataclass
class Position:
    x: int
    y: int

def draw_grid(width, height):
    """Draws the grid on the screen."""
    print("\n".join(["=".join(["-" * width] * (height + 1))] * (height)))

def main():
    # Define game parameters
    width = 20
    height = 20
    
    # Initialize snake and food positions
    initial_snake_length = 3
    head_x, head_y = random.randint(1, width - 2), random.randint(1, height - 2)
    body_positions: List[Position] = [Position(head_x, head_y)]
    
    def get_food_position():
        while True:
            food_x, food_y = random.randint(1, width - 2), random.randint(1, height - 2)
            if (food_x, food_y) not in body_positions:
                return Position(food_x, food_y)

    food_pos = get_food_position()
    
    # Initialize score
    score = 0
    
    def draw_snake():
        """Draws the snake on the grid."""
        for pos in body_positions:
            print(f"\u25A0" if (pos.x, pos.y) == head else " ", end="")
        print("H", end="")  # Display head of the snake
        print()
    
    def draw_food():
        """Draws food on the grid."""
        print("\u2B1C" if food_pos != body_positions[0] else "", end="")
    
    move_dir = "right"
    while True:
        input_direction = input("Use arrow keys to control the snake (or 'q' to quit): ").strip().lower()
        if input_direction == "q":
            break
        
        if move_dir not in ("left", "up", "down", "right"):
            continue
        
        new_head_pos = Position(head_x, head_y)
        
        if move_dir == "left":
            new_head_pos.x -= 1
        elif move_dir == "right":
            new_head_pos.x += 1
        elif move_dir == "up":
            new_head_pos.y -= 1
        elif move_dir == "down":
            new_head_pos.y += 1
        
        if (new_head_pos.x < 0 or new_head_pos.x >= width or 
            new_head_pos.y < 0 or new_head_pos.y >= height or
            new_head_pos in body_positions):
            print("Game Over!")
            break
        
        body_positions.insert(0, new_head_pos)
        
        if food_pos == new_head_pos:
            score += 1
            food_pos = get_food_position()
        else:
            body_positions.pop()
        
        draw_grid(width, height)
        draw_snake()
        draw_food()

if __name__ == "__main__":
    main()
```

### Explanation of the Code:

- **draw_grid**: Draws a grid on the screen.
- **main function**:
  - Initializes the game board size (width and height).
  - Sets initial snake positions, ensuring the head is different from the body.
  - Randomly places food outside the snake’s body.
  - Continuously checks user input for movement control.
  - Updates the snake's position based on direction.
  - Checks collision conditions with boundaries and its own body.
  - Handles game over condition if the snake collides.
  - Displays score after each successful move or food consumption.

This implementation uses ASCII characters to represent the grid, snake, and food. You can customize it further as needed.

