        print('Game Over!')
        break
    # Check for food consumption
    if new_head == generate_food(board_width, board_height):
        snake_length += 1
        continue
    # Move the existing body segments forward
    initial_snake_body = [(head_x, head_y)] + initial_snake_body[:-1]
    direction_change = input("Enter 'w' to go up, 's' to go down, 'a' to go left, or 'd' to go right: ")
