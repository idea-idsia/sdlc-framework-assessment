import pygame
from game_controller import GameController

class KeyHandler:
    def __init__(self, controller: GameController):
        self.controller = controller
    
    def handle_input(self):
        event_list = pygame.event.get()
        for event in event_list:
            if event.type == pygame.KEYDOWN and event.key in [pygame.K_LEFT, pygame.K_RIGHT, pygame.K_UP, pygame.K_DOWN]:
                direction = {'LEFT': 'UP', 'RIGHT': 'DOWN', 'UP': 'LEFT', 'DOWN': 'RIGHT'}[event.key]
                try:
                    self.controller.update_board(direction)
                except CollisionError as e:
                    print(e)

        if not self.controller.update_board(self.snake_direction_manager.get_direction()):
            return False
        return True
