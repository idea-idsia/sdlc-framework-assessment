import score_manager
import display_score
import graphics_and_ui_design
import animations_for_snake_movement

def main():
    pygame.init()
    
    # Initialize game settings and objects
    board = GameBoard(size=10)
    snake = Snake(board_size=board.size)
    display = DisplayScore(pygame.display.set_mode((800, 600)))
    graphics_design = GraphicsAndUIDesign()
    animation_effects = ImplementAnimationEffects(display.surface)
    
    # Main game loop
    running = True
    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            
            if key_handler.handle_input(event):
                snake.move_snake(direction=event.key)
        
        graphics_design.draw(snake.segments)
        display.draw(score=snake.score)
        
        animation_effects.update_snake()
        animation_effects.flash_collision(time=animation_effects.flash_duration)
        
        pygame.display.flip()
    
    pygame.quit()

if __name__ == "__main__":
    main()
