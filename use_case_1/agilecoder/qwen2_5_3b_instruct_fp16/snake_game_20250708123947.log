from typing import List, Tuple
import random
import game_board as gb
import snake_init as si
import collision_handler as ch
def grow_snake(snake: si.Snake) -> None:
    """Grow the snake by adding a new segment."""
    if not ch.handle_collision(snake):
        food_pos = generate_food(snake)
        gb.board[food_pos] = '10'
        snake.length += 1
