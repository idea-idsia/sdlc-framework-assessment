        x, y = position
        if direction == 'UP':
            return (x, y - 25)
        elif direction == 'DOWN':
            return (x, y + 25)
        elif direction == 'LEFT':
            return (x - 25, y)
        else:  # RIGHT
            return (x + 25, y)

