'''
Game Board implementation.
Handles grid-based layout with dimensions defined by a 10x10 grid.
'''
import random
from typing import List, Tuple
def generate_grid(size: int) -> List[List[str]]:
    """Generate the game board."""
    return [[str(x + y * size).zfill(2) for x in range(size)] for y in range(size)]
GRID_SIZE = 10
board = generate_grid(GRID_SIZE)
