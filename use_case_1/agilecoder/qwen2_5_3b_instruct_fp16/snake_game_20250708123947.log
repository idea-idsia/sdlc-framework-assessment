            self.snake_body.append(tuple(self.snake_head.pop()))
        # Generate food
        if head not in self.snake_body:
            while True:
                x = random.randint(0, self.grid_size - 1)
                y = random.randint(0, self.grid_size - 1)
                if (x, y) != tuple(head):
                    break
            self.snake_body.append((x, y))
        else:
            self.score += 1
            self.generate_food()
        return True
    def get_new_head(self, head, direction):
        x, y = head
        new_x = x + (direction == 'right') - (direction == 'left')
        new_y = y + (direction == 'down') - (direction == 'up')
        return (new_x, new_y)
    def generate_food(self):
        # Ensure food is not on the snake's body
        while True:
            x = random.randint(0, self.grid_size - 1)
            y = random.randint(0, self.grid_size - 1)
            if (x, y) != tuple(head for head in self.snake_head):
                break
        return (x, y)
    def play_game(self):
        while True:
            key_press = input("Press 'w' for up, 's' for down, 'a' for left, and 'd' for right: ").lower()
            if key_press in ['w', 's', 'a', 'd']:
                self.direction = key_press
                break
        while True:
            if not self.move_snake():
                print("Game Over!")
                return
            self.draw_board()
            time.sleep(0.2)
if __name__ == "__main__":
    game = SnakeGame(grid_size=10)
    game.play_game()
