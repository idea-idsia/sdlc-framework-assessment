'''
Food generation module.
Randomly places food on the game board avoiding the snake's body.
'''
from typing import List, Tuple
import random
import game_board as gb
import snake_init as si
def generate_food(snake: si.Snake) -> Tuple[int]:
    """Generate a new piece of food."""
    while True:
        food_pos = (random.randint(0, 9), random.randint(0, 9))
        if food_pos not in snake.body and gb.board[food_pos] != '10':
            return food_pos
