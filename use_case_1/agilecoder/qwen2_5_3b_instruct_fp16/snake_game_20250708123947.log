def game_board(size):
    '''Print the current state of the game board'''
    print('\n' * 2)  # Clear previous output
    for y in range(size):
        row = []
        for x in range(size):
            if (x, y) == snake[0]:
                row.append('X')  # Snake head
            elif (x, y) in snake:
                row.append('+')  # Snake body segment
            else:
                row.append(' ')
        print('|' + '|'.join(row) + '|')
def game_over():
    '''Display the game over message'''
    print('\nGame Over!\n')
    print(f'Score: {len(snake) - 1}')
if __name__ == '__main__':
    main()
