graphics_and_ui
```python
'''
Display the game board, snake, and food.
'''

import curses

def display_grid(stdscr):
    for y in range(10):
        stdscr.addstr(y, 0, "+---" * 10 + "+")
        for x in range(10):
            if (x, y) == snake_head_position:
                stdscr.addstr(y, x*2+1, "| S |", curses.A_STANDOUT)
            elif (x, y) == food_position:
                stdscr.addstr(y, x*2+1, "| # |", curses.A_BOLD)
            else:
                stdscr.addstr(y, x*2+1, "|   |")
    stdscr.refresh()

def draw_snake(snake_positions):
    for (x, y) in snake_positions:
        if (x, y) == snake_head_position:
            print("S", end="")
        else:
            print("O", end="")

def draw_food(food_position):
    if food_position == snake_head_position:
        print("*", end="")
    else:
        print("#", end="")

def main():
    global snake_positions, food_position, game_over
    
    stdscr = curses.initscr()
    display_grid(stdscr)
    
    while not game_over:
        draw_snake(snake_positions)
        draw_food(food_position)
        stdscr.refresh()

if __name__ == "__main__":
    main()
```

