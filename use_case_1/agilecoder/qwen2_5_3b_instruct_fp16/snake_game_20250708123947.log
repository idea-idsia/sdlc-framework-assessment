        pass

    @staticmethod
    def detect_collision(snake_head, snake_body):
        x, y = snake_head
        for segment in snake_body:
            if (x - 1, y) == segment or (x + 1, y) == segment or (x, y - 1) == segment or (x, y + 1) == segment:
                return True
        return False

    @staticmethod
