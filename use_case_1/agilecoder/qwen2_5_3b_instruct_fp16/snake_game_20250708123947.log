'''
Snake Game
This program implements a basic Snake game with graphical representation.
Controls:
- Arrow keys for moving the snake.
Game Over Conditions:
- Collision with boundaries or own body.
Score Displayed: 
Current score is shown on screen and reset upon restarting.
'''
class Grid:
    def __init__(self, width=10, height=10):
        self.width = width
        self.height = height
    def draw(self):
        for y in range(self.height):
            if y == 0 or y == self.height - 1:
                print('#' * (self.width + 2))
            else:
                row = '#' + ' ' * self.width + '#'
                print(row)
        print('#' * (self.width + 2))
class Snake:
    def __init__(self, grid):
        self.grid = grid
        self.body = [(3, 5), (4, 5)]  # Initial snake position and length.
        self.direction = 'right'
    def move(self):
        head_x, head_y = self.body[0]
        if self.direction == 'up':
            new_head = (head_x, head_y - 1)
        elif self.direction == 'down':
            new_head = (head_x, head_y + 1)
        elif self.direction == 'left':
            new_head = (head_x - 1, head_y)
        else:  # Direction is 'right'
            new_head = (head_x + 1, head_y)
        if not (0 <= new_head[0] < self.grid.width and
                0 <= new_head[1] < self.grid.height):
            return False
        self.body.insert(0, new_head)
        if len(self.body) > self.grid.width * self.grid.height:
            del self.body[-1]
        return True
    def grow(self):
        tail_x, tail_y = self.body[-1]
        if self.direction == 'up':
            new_tail = (tail_x, tail_y + 1)
        elif self.direction == 'down':
            new_tail = (tail_x, tail_y - 1)
        elif self.direction == 'left':
            new_tail = (tail_x + 1, tail_y)
        else:  # Direction is 'right'
            new_tail = (tail_x - 1, tail_y)
        if not (0 <= new_tail[0] < self.grid.width and
                0 <= new_tail[1] < self.grid.height):
            return False
        self.body.append(new_tail)
        return True
class Food:
    def __init__(self, grid):
        self.grid = grid
        self.position = (random.randint(1, grid.width - 2), random.randint(1, grid.height - 2))
    def generate(self):
        if not (0 <= self.position[0] < self.grid.width and
                0 <= self.position[1] < self.grid.height):
            return False
        for part in Snake.body:
            if part == self.position:
                return False
        return True
class Game:
    def __init__(self, width=10, height=10):
        self.width = width
        self.height = height
        self.snake = Snake(self)
        self.food = Food(self)
    def play(self):
        grid = Grid(self.width, self.height)
        score = 0
        while True:
            grid.draw()
            snake = self.snake.move()
            if not snake:
                print("Game Over! You hit the boundary.")
                break
            food_position = self.food.position
            if self.snake.body[0] == food_position and self.snake.grow():
                score += 1
                print(f"Score: {score}")
            time.sleep(0.2)  # Adjust speed as needed.
if __name__ == "__main__":
    game = Game()
    game.play()
