def generate_game_board():
    """
    Generates a 10x10 grid-based game board.
    """
    return [[' ']*10 for _ in range(10)]
```

### Snake Initialization

The snake will be represented as an upward arrow `^` on the board. The initial length is set to 3, and it starts moving right initially.

```python
snake.py
```python
from game_board import generate_game_board

def initialize_snake():
    """
    Initializes a snake of length 3 with the head at (1,0) facing right.
    """
    board = generate_game_board()
    snake_head = (1, 0)
    snake_body = [(snake_head[0], snake_head[1]-i) for i in range(3)]
    
    return board, snake_body
```

### Snake Movement

The snake will move based on arrow key inputs. We'll use a dictionary to map the keys to movement directions.

```python
movement.py
```python
def handle_movement(board, direction):
    """
    Handles the movement of the snake based on the given direction.
    
    :param board: The current state of the game board (list).
    :param direction: A string representing the new direction ('left', 'right', 'up', 'down').
    """
    head_x, head_y = next(iter(board[0]))  # Get the top-left corner
    
    if direction == 'left':
        new_head = (head_x - 1, head_y)
    elif direction == 'right':
        new_head = (head_x + 1, head_y)
    elif direction == 'up':
        new_head = (head_x, head_y - 1)
    else:  # Down
        new_head = (head_x, head_y + 1)

    if not is_valid_move(board, new_head):
        return False
    
    for body_part in board[0]:
        board[board.index([body_part])].remove(body_part)
    
    snake_body.append(new_head)
    
    return True
```

### Food Generation

The food will be represented as a circle `o`. We'll generate it at random positions on the grid, ensuring that it doesn't appear where the snake is.

```python
food.py
```python
import random

def place_food(board):
    """
    Places a new piece of food in a valid position.
    
    :param board: The current state of the game board (list).
    """
    while True:
        x, y = random.randint(1, 9), random.randint(1, 9)
        
        if (x, y) not in [p for p in snake_body(board)]:
            break
    
    board[x][y] = 'o'
    
    return board
```

### Collision Handling

The game checks for collisions against the boundaries and the snake's body.

```python
collision.py
```python
def is_valid_move(board, new_head):
    """
    Checks if a move to the given head position would be valid.
    
    :param board: The current state of the game board (list).
    :param new_head: A tuple representing the new head position.
    :return: True if valid, False otherwise.
    """
    x, y = new_head
    return 0 < x < 10 and 0 < y < 10

def detect_collision(board):
    """
    Detects collisions with boundaries or snake body.
    
    :param board: The current state of the game board (list).
    :return: True if a collision is detected, False otherwise.
    """
    head_x, head_y = next(iter(board[0]))
    tail_x, tail_y = snake_body(board)[-1]
    
    # Check boundaries
    if not is_valid_move(board, (head_x-1, head_y)):
        return True
    
    if not is_valid_move(board, (head_x+1, head_y)):
        return True
    
    if not is_valid_move(board, (head_x, head_y-1)):
        return True
    
    if not is_valid_move(board, (head_x, head_y+1)):
        return True

    # Check collision with the snake body
    if tail_x != head_x or tail_y != head_y:
        return True
    
    return False

def detect_food_collision(board):
    """
    Detects collisions between the snake and food.
    
    :param board: The current state of the game board (list).
    :return: True if a collision is detected, False otherwise.
    """
    x, y = next(iter(board[0]))
    return 'o' in board[x][y:y+1] or 'o' in board[x-1:x]
```

### Snake Growth

The snake grows when it eats food.

```python
growth.py
```python
def grow_snake(board):
    """
    Updates the board to reflect the new position of the head after eating food.
    
    :param board: The current state of the game board (list).
    """
    for i, segment in enumerate(snake_body(board)):
        if i == 0:
            continue
        
        x1, y1 = snake_body(board)[i-1]
        x2, y2 = segment
        new_segment = (x1 + (x2 - x1) // abs(x2-x1), y1 + (y2 - y1) // abs(y2-y1))
        
        if not detect_collision(board):
            board[x1][y1] = ' '
            snake_body(board).append(new_segment)
```

