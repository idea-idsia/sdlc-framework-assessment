'''
Move the snake based on arrow key input.
'''

def move_snake(snake_body, direction):
    global is_running
    if is_running:
        # Get current position of head and add new segment in next_direction.
        head = snake_head[0]
        next_segment = [head[0]+direction[0], head[1]+direction[1]]
        
        # Ensure the new segment doesn't collide with itself or go out of bounds.
        if next_segment not in snake_body:
            snake_head.insert(0, next_segment)
            
            # Remove tail if it has been eaten by food.
            if (next_segment == food_position):
                remove_tail()
            else:
                tail = snake_body[-1]
                snake_body.pop()
        
        # Update game board and score display.
        update_game_board()

def handle_keys():
    global direction
    keys = pygame.key.get_pressed()
    
    if keys[pygame.K_UP]:
        direction = (0, -1)
    elif keys[pygame.K_DOWN]:
        direction = (0, 1)
    elif keys[pygame.K_LEFT]:
        direction = (-1, 0)
    elif keys[pygame.K_RIGHT]:
        direction = (1, 0)

```

