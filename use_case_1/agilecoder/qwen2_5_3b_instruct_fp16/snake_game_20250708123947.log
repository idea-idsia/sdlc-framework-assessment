import random
import time

# Game Board Dimensions
GRID_WIDTH = 20
GRID_HEIGHT = 20

# Snake Constants
SNAKE_SIZE = 3
INITIAL_X = GRID_WIDTH // 2 - SNAKE_SIZE // 2
INITIAL_Y = GRID_HEIGHT // 2 - SNAKE_SIZE // 2
HEAD = '■'
BODY_PART = '●'

# Directions
UP = 'up'
DOWN = 'down'
LEFT = 'left'
RIGHT = 'right'

