                    (snake[-1][1] + DIRECTIONS[direction.upper()][1]) % GRID_SIZE]
        if new_head not in snake.positions:
            snake.positions.append(new_head)
        return snake
    # Define possible directions
    DIRECTIONS = {'UP': (-1, 0), 'DOWN': (1, 0), 'LEFT': (0, -1), 'RIGHT': (0, 1)}
