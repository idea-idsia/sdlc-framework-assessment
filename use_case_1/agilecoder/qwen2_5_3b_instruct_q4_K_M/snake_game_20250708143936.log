        # Define possible directions and their corresponding movements in a tuple format
        DIRECTIONS = {curses.KEY_LEFT: (-1, 0), curses.KEY_RIGHT: (1, 0), 
                      curses.KEY_UP: (0, -1), curses.KEY_DOWN: (0, 1)}
        key = snake.board.snake.getch()
