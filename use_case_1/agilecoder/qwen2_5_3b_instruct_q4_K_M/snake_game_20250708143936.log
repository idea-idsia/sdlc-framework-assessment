        direction = DIRECTIONS[key]
        new_head_x, new_head_y = head_x + direction[0], head_y + direction[1]
        if (new_head_x, new_head_y) not in snake.positions:
            snake.positions.insert(0, (new_head_x, new_head_y))
    return move_snake(snake)
