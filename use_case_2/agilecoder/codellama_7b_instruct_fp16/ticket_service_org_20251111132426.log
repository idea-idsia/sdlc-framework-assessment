'''
File: i.py
Author: $USERNAME
Description: $DESCRIPTION
'''
from flask import Flask, request, jsonify
app = Flask(__name__)
@app.route("/api/v1/tickets", methods=["GET"])
def get_all_tickets():
    tickets = []
    for ticket in TicketManagementSystem().get_all_tickets():
        tickets.append({"ticket_id": ticket.ticket_number, "status": ticket.status})
    return jsonify(tickets)
@app.route("/api/v1/tickets", methods=["POST"])
def create_ticket():
    data = request.get_json()
    TicketManagementSystem().create_ticket(data["ticket_id"], data["status"])
    return jsonify({"message": "Ticket created successfully"}), 201
@app.route("/api/v1/tickets/<int:ticket_id>", methods=["PUT"])
def update_ticket(ticket_id):
    data = request.get_json()
    TicketManagementSystem().update_ticket(ticket_id, data["status"])
    return jsonify({"message": "Ticket updated successfully"}), 201
@app.route("/api/v1/tickets/<int:ticket_id>", methods=["DELETE"])
def delete_ticket(ticket_id):
    TicketManagementSystem().delete_ticket(ticket_id)
    return jsonify({"message": "Ticket deleted successfully"}), 201
if __name__ == "__main__":
    app.run()
