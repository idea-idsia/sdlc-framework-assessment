        '''
        Constructor for the Ticket class.
        Args:
            tms: The TicketManagementSystem object that provides access to the database and other functionalities.
            id: The unique identifier of the ticket.
        '''
        self.tms = tms
        self.id = id
        self.description = None
        self.category = None
        self.status = 'open'
