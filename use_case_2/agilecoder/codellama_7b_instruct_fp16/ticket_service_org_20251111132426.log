    # Delete a ticket from the database
    tms.delete_ticket('admin', 1)

    # Display all tickets in the database
    for ticket in tms.get_all_tickets():
        print(f"Ticket {ticket.id}: {ticket.description}")

if __name__ == '__main__':
    main()
