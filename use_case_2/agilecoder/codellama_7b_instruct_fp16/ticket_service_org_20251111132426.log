from tkinter import Tk, Label, Button, Entry, StringVar
from ticket_management_system import TicketManagementSystem
class App:
    def __init__(self):
        self.root = Tk()
        self.root.title("Ticket Management System")
        self.tms = TicketManagementSystem()
        self.username_label = Label(self.root, text="Username: ")
        self.username_label.pack()
        self.username_entry = Entry(self.root)
        self.username_entry.pack()
        self.create_ticket_button = Button(self.root, text="Create Ticket", command=self.create_ticket)
        self.create_ticket_button.pack()
        self.view_tickets_button = Button(self.root, text="View Tickets", command=self.view_tickets)
        self.view_tickets_button.pack()
        self.update_ticket_button = Button(self.root, text="Update Ticket", command=self.update_ticket)
        self.update_ticket_button.pack()
        self.delete_ticket_button = Button(self.root, text="Delete Ticket", command=self.delete_ticket)
        self.delete_ticket_button.pack()
        self.logout_button = Button(self.root, text="Logout", command=self.logout)
        self.logout_button.pack()
    def create_ticket(self):
        ticket_id = str(uuid.uuid4())
        self.tms.create_ticket(ticket_id, "open")
    def view_tickets(self):
        tickets = self.tms.get_all_tickets()
        for ticket in tickets:
            print("Ticket ID:", ticket["ticket_id"], "Status:", ticket["status"])
    def update_ticket(self):
        ticket_id = input("Enter the ticket ID you want to update: ")
        status = input("Enter the new status of the ticket (open/active/closed): ")
        self.tms.update_ticket(ticket_id, status)
    def delete_ticket(self):
        ticket_id = input("Enter the ticket ID you want to delete: ")
        self.tms.delete_ticket(ticket_id)
    def logout(self):
        print("Logging out...")
        sys.exit()
if __name__ == "__main__":
    app = App()
    app.root.mainloop()
