        query = "SELECT id, description, category FROM tickets"
        results = self.sqlite_db.execute(query).fetchall()
        for row in results:
            self.tickets.insert(END, str(row[0]) + ": " + row[1] + " (" + constants.CATEGORY_CHOICES[row[2]] + ")")
