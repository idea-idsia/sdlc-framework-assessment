'''
Implements the graphical user interface using Tkinter.
Allows users to log in as helpdesk staff or simple users, manage tickets,
and perform data analysis.
'''
import tkinter as tk
from tkinter import messagebox, ttk
from database_manager import DatabaseManager
from microservices import Microservices
from user_manager import UserRole, UserManager

class TicketApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Ticket Management System")
        self.user_role = None  # This will be set when the user logs in
        self.db_manager = DatabaseManager()
        self.microservices = Microservices()
        self.user_manager = UserManager()
        self.create_login_widgets()

    def create_login_widgets(self):
        frame = tk.Frame(self)
        frame.pack(pady=20)

        ttk.Label(frame, text="Select Role:").grid(row=0, column=0, padx=10)
        self.role_var = tk.StringVar()
        roles = ["Helpdesk User", "Simple User"]
        role_menu = ttk.OptionMenu(frame, self.role_var, roles[0], *roles)
        role_menu.grid(row=0, column=1, padx=10)

        login_button = ttk.Button(frame, text="Login", command=self.login)
        login_button.grid(row=0, column=2, padx=10)

    def login(self):
        selected_role = self.role_var.get()
        if selected_role == "Helpdesk User":
            self.user_role = UserRole.HELPDESK_USER
            messagebox.showinfo("Login", "Logged in as Helpdesk User")
        elif selected_role == "Simple User":
            self.user_role = UserRole.SIMPLE_USER
            messagebox.showinfo("Login", "Logged in as Simple User")

        self.clear_widgets()
        self.create_main_widgets()

    def clear_widgets(self):
        for widget in self.winfo_children():
            widget.destroy()

    def create_main_widgets(self):
        main_frame = tk.Frame(self)
        main_frame.pack(pady=20)

        add_button = ttk.Button(main_frame, text="Add Ticket", command=self.add_ticket)
        add_button.grid(row=0, column=0, padx=10)

        view_button = ttk.Button(main_frame, text="View Tickets", command=self.view_tickets)
        view_button.grid(row=0, column=1, padx=10)

        if self.user_role == UserRole.HELPDESK_USER:
            change_status_button = ttk.Button(main_frame, text="Change Ticket Status", command=self.change_ticket_status)
            change_status_button.grid(row=0, column=2, padx=10)

        analysis_button = ttk.Button(main_frame, text="Analysis", command=self.analysis)
        analysis_button.grid(row=0, column=3, padx=10)

    def add_ticket(self):
        add_window = tk.Toplevel(self)
        add_window.title("Add Ticket")

        frame = tk.Frame(add_window)
        frame.pack(pady=20)

        ttk.Label(frame, text="Title:").grid(row=0, column=0, padx=10)
        title_entry = ttk.Entry(frame)
        title_entry.grid(row=0, column=1, padx=10)

        ttk.Label(frame, text="Description:").grid(row=1, column=0, padx=10)
        description_entry = tk.Text(frame, height=5, width=30)
        description_entry.grid(row=1, column=1, padx=10)

        save_button = ttk.Button(frame, text="Save", command=lambda: self.save_ticket(title_entry.get(), description_entry.get("1.0", "end-1c")))
        save_button.grid(row=2, columnspan=2, pady=10)

    def save_ticket(self, title, description):
        if not title or not description:
            messagebox.showerror("Error", "Title and Description cannot be empty")
            return

        self.db_manager.add_ticket(title, description)
        messagebox.showinfo("Success", "Ticket added successfully")

    def view_tickets(self):
        view_window = tk.Toplevel(self)
        view_window.title("View Tickets")

        frame = tk.Frame(view_window)
        frame.pack(pady=20)

        tickets = self.db_manager.get_all_tickets()
        for ticket in tickets:
            ttk.Label(frame, text=f"ID: {ticket[0]}, Title: {ticket[1]}, Description: {ticket[2]}").pack()

    def change_ticket_status(self):
        change_window = tk.Toplevel(self)
        change_window.title("Change Ticket Status")

        frame = tk.Frame(change_window)
        frame.pack(pady=20)

        ttk.Label(frame, text="Ticket ID:").grid(row=0, column=0, padx=10)
        id_entry = ttk.Entry(frame)
        id_entry.grid(row=0, column=1, padx=10)

        ttk.Label(frame, text="New Status:").grid(row=1, column=0, padx=10)
        status_var = tk.StringVar()
        status_menu = ttk.OptionMenu(frame, status_var, "open", "open", "active", "closed")
        status_menu.grid(row=1, column=1, padx=10)

        save_button = ttk.Button(frame, text="Save", command=lambda: self.save_status_change(id_entry.get(), status_var.get()))
        save_button.grid(row=2, columnspan=2, pady=10)

    def save_status_change(self, ticket_id, new_status):
        if not ticket_id or new_status not in ["open", "active", "closed"]:
            messagebox.showerror("Error", "Invalid Ticket ID or Status")
            return

        self.db_manager.change_ticket_status(ticket_id, new_status)
        messagebox.showinfo("Success", "Ticket status changed successfully")

    def analysis(self):
        analysis_window = tk.Toplevel(self)
        analysis_window.title("Analysis")

        frame = tk.Frame(analysis_window)
        frame.pack(pady=20)

        ttk.Label(frame, text="Select Analysis:").grid(row=0, column=0, padx=10)
        self.analysis_var = tk.StringVar()
        analyses = ["Open Ticket Count", "Active Ticket Count", "Closed Ticket Count", "Average Resolution Time"]
        analysis_menu = ttk.OptionMenu(frame, self.analysis_var, analyses[0], *analyses)
        analysis_menu.grid(row=0, column=1, padx=10)

        run_button = ttk.Button(frame, text="Run", command=self.run_analysis)
        run_button.grid(row=0, column=2, padx=10)

    def run_analysis(self):
        selected_analysis = self.analysis_var.get()
        if selected_analysis == "Open Ticket Count":
            count = self.microservices.get_open_ticket_count()
            messagebox.showinfo("Result", f"Open Tickets: {count}")
        elif selected_analysis == "Active Ticket Count":
            count = self.microservices.get_active_ticket_count()
            messagebox.showinfo("Result", f"Active Tickets: {count}")
        elif selected_analysis == "Closed Ticket Count":
            count = self.microservices.get_closed_ticket_count()
            messagebox.showinfo("Result", f"Closed Tickets: {count}")
        elif selected_analysis == "Average Resolution Time":
            avg_time = self.microservices.get_average_resolution_time()
            messagebox.showinfo("Result", f"Average Resolution Time: {avg_time} days")

if __name__ == "__main__":
    app = TicketApp()
    app.mainloop()
