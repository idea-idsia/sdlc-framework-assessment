                WHERE id=?
            ''', (ticket_id,))
        self.conn.commit()
    def add_message(self, ticket_id, message):
        cursor = self.conn.cursor()
        cursor.execute('''
            INSERT INTO messages (ticket_id, message)
            VALUES (?, ?)
        ''', (ticket_id, message))
        self.conn.commit()
    def get_tickets_by_status(self, status):
        cursor = self.conn.cursor()
        cursor.execute('''
            SELECT id, created_date, description, category
            FROM tickets
            WHERE status=?
        ''', (status,))
