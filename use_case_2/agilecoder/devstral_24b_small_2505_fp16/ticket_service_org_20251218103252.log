                    created_date DATETIME DEFAULT CURRENT_TIMESTAMP,
                    description TEXT,
                    status TEXT
                )
            ''')
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS messages (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    ticket_id INTEGER,
                    message TEXT,
                    FOREIGN KEY (ticket_id) REFERENCES tickets(id)
                )
            ''')
        except sqlite3.Error as e:
