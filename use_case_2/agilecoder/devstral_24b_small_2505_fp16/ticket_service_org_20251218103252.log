```python
'''
Database Manager module for handling database operations.
'''
import sqlite3

class DatabaseManager:
    def __init__(self, db_name="tickets.db"):
        self.conn = sqlite3.connect(db_name)

    def get_all_tickets(self):
        cursor = self.conn.cursor()
        try:
            cursor.execute('SELECT * FROM tickets')
            return cursor.fetchall()
        except sqlite3.Error as e:
            print(f"Database error: {e}")
            return []

    def get_ticket_by_id(self, ticket_id):
        cursor = self.conn.cursor()
        try:
            cursor.execute('SELECT * FROM tickets WHERE id = ?', (ticket_id,))
            return cursor.fetchone()
        except sqlite3.Error as e:
            print(f"Database error: {e}")
            return None

    def add_ticket(self, description, status, category):
        try:
            with self.conn:
                self.conn.execute('INSERT INTO tickets (description, status, category) VALUES (?, ?, ?)',
                                  (description, status, category))
                return True
        except sqlite3.Error as e:
            print(f"Database error: {e}")
            return False

    def update_ticket(self, ticket_id, description=None, status=None, closed_at=None):
        try:
            with self.conn:
                updates = []
                params = []
                if description is not None:
                    updates.append('description = ?')
                    params.append(description)
                if status is not None:
                    updates.append('status = ?')
                    params.append(status)
                if closed_at is not None:
                    updates.append('closed_at = ?')
                    params.append(closed_at)
                query = f'UPDATE tickets SET {", ".join(updates)} WHERE id = ?'
                params.append(ticket_id)
                self.conn.execute(query, tuple(params))
                return True
        except sqlite3.Error as e:
            print(f"Database error: {e}")
            return False

    def delete_ticket(self, ticket_id):
        try:
            with self.conn:
                self.conn.execute('DELETE FROM tickets WHERE id = ?', (ticket_id,))
                return True
        except sqlite3.Error as e:
            print(f"Database error: {e}")
            return False
