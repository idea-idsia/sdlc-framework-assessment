class TicketApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Ticket Management System")
        # Initialize database manager
        self.db_manager = DatabaseManager()
        # User role selection
        self.user_role_var = tk.StringVar(value="simple_user")
        self.create_widgets()
