            top.destroy()

        button = tk.Button(top, text="Save Message", command=save_message)
        button.pack()

    # Functionality for Service 1 (Open Ticket Count) can be added here

# Application main loop
if __name__ == "__main__":
    root = tk.Tk()
    app = TicketApp(root)
    root.mainloop()
