            time_filter = f'-{days} days' if days else f'-{hours} hours'
            cursor.execute('SELECT COUNT(*) FROM tickets WHERE status=? AND created_at >= datetime("now", ?)', ('closed', time_filter))
            return cursor.fetchone()[0]
