        try:
            self.db_manager.add_ticket(description, category)
            messagebox.showinfo("Success", "Ticket added successfully!")
        except Exception as e:
            messagebox.showerror("Error", str(e))

if __name__ == "__main__":
    root = tk.Tk()
    app = TicketApp(root)
    root.mainloop()
