        self.db = db
    def get_open_tickets(self):
        try:
            self.db.cursor.execute("SELECT * FROM tickets WHERE status='open'")
            return self.db.cursor.fetchall()
        except sqlite3.Error as e:
            print(f"An error occurred: {str(e)}")
