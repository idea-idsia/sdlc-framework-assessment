import sqlite3

class Database:
    def __init__(self):
        self.db = sqlite3.connect('tickets.db')
        self.cursor = self.db.cursor()
        self.create_table()

    def create_table(self):
        query = """CREATE TABLE IF NOT EXISTS tickets (
            id INTEGER PRIMARY KEY,
            description TEXT,
            status TEXT
        )"""
        self.cursor.execute(query)
        self.db.commit()
