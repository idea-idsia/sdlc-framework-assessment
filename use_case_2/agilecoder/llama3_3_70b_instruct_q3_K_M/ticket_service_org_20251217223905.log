        if user_type == "helpdesk":
            ticket_management_system = TicketManagementSystem("helpdesk")
            ticket_management_system.run()
        elif user_type == "simple_user":
            ticket_management_system = TicketManagementSystem("simple_user")
            ticket_management_system.run()
    def run(self):
        self.root.mainloop()
