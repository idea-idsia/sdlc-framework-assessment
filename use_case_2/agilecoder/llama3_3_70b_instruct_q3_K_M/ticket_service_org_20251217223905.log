        pass
    def get_data(self):
        db = Database()
        query = "SELECT AVG(strftime('%s', closed_at) - strftime('%s', created_at)) FROM tickets WHERE status = 'closed'"
        db.cursor.execute(query)
        result = db.cursor.fetchone()
        return result
