            self.ticket_text_box = tk.Text(self.simple_user_frame)
            self.ticket_text_box.pack()
            for ticket in result:
                self.ticket_text_box.insert(tk.END, str(ticket) + "\n")
        except Exception as e:
            print("An error occurred: {}".format(e))

    def run(self):
        self.root.mainloop()
