        self.root = root
        self.frame = tk.Frame(self.root)
        self.frame.pack()
        self.label = tk.Label(self.frame, text="Ticket Management System")
        self.label.pack()
        self.button = tk.Button(self.frame, text="Login", command=self.login)
        self.button.pack()
