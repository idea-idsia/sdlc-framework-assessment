from database import Database
class Service2:
    def __init__(self):
        pass
    def get_data(self):
        db = Database()
        query = "SELECT AVG(strftime('%J', closed_at) - strftime('%J', created_at)) FROM tickets WHERE status = 'closed'"
        db.cursor.execute(query)
        result = db.cursor.fetchone()
        return result
