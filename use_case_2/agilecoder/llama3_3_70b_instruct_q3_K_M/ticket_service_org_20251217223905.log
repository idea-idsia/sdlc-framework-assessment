import sqlite3
class Database:
    def __init__(self, db_name):
        self.conn = sqlite3.connect(db_name)
        self.cursor = self.conn.cursor()
    def insert_data(self, table_name, data):
        self.cursor.execute(f"INSERT INTO {table_name} VALUES ({','.join(['?'] * len(data))})", data)
        self.conn.commit()
    def cursor(self):
        return self.cursor
