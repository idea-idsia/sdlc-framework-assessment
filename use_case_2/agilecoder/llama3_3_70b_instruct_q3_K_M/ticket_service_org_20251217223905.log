            id INTEGER PRIMARY KEY AUTOINCREMENT,
            description TEXT NOT NULL,
            category TEXT NOT NULL,
            status TEXT DEFAULT 'open',
            opening_date DATE NOT NULL
        )
    ''')
    self.conn.commit()

# Modify the Database class to create tables upon initialization
class Database:
