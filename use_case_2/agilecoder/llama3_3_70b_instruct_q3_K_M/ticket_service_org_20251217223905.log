from database import Database
class Service1:
    def __init__(self):
        pass
    def get_data(self, period):
        db = Database()
        query = "SELECT * FROM tickets WHERE status = 'open' AND created_at >= datetime('now', ?)"
        db.cursor.execute(query, (f'-{period} hours',))
        result = db.cursor.fetchall()
        return result
