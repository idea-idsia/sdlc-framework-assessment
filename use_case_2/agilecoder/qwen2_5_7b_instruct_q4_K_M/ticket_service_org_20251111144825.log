     def get_average_ticket_resolution_time_by_month(self):
         total_resolved_tickets = 0
         total_resolution_time = 0
         resolved_tickets = [ticket for ticket in self.db_manager.get_all_tickets() if ticket["status"] == "closed"]
         for ticket in resolved_tickets:
             created_time = datetime.strptime(ticket["created_time"], "%Y-%m-%d %H:%M:%S")
             closed_time = datetime.strptime(ticket["closed_time"], "%Y-%m-%d %H:%M:%S")
             duration = (closed_time - created_time).total_seconds()
             total_resolution_time += duration
             total_resolved_tickets += 1

         if total_resolved_tickets > 0:
