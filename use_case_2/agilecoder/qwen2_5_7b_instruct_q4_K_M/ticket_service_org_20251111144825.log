```python
'''
Handle database operations.
'''
import sqlite3
class DatabaseManager:
    def __init__(self):
        self.conn = None
    def connect_to_db(self):
        self.conn = sqlite3.connect('tickets.db')
    def add_ticket(self, ticket_dict):
        if not self.conn:
            self.connect_to_db()
        cursor = self.conn.cursor()
        sql = """INSERT INTO tickets (category, description) VALUES (?, ?)"""
        values = (ticket_dict['category'], ticket_dict['description'])
        cursor.execute(sql, values)
        self.conn.commit()
    def get_all_tickets(self):
        if not self.conn:
            self.connect_to_db()
        cursor = self.conn.cursor()
        sql = "SELECT * FROM tickets WHERE status = 'Open' OR status = 'Active'"
        cursor.execute(sql)
        return [dict(zip([column[0] for column in cursor.description], row)) for row in cursor.fetchall()]
    def update_ticket_status(self, ticket_id, new_status):
        if not self.conn:
            self.connect_to_db()
        cursor = self.conn.cursor()
        sql = "UPDATE tickets SET status = ? WHERE id = ?"
        values = (new_status, ticket_id)
        cursor.execute(sql, values)
        self.conn.commit()
    def close(self):
        self.conn.close()
