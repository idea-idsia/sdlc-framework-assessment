        query = 'INSERT INTO tickets (category, description, status, created_time, last_modified_time) VALUES (?, ?, "open", CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)'
        self.cursor.execute(query, (ticket.category, ticket.description))
