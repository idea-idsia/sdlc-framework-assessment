import sqlite3

def main():
    conn = sqlite3.connect('tickets.db')
    cursor = conn.cursor()

    # Create tables
    cursor.execute('''CREATE TABLE IF NOT EXISTS users (
                        username TEXT PRIMARY KEY,
                        password_hash TEXT
                    )''')
    cursor.execute('''CREATE TABLE IF NOT EXISTS tickets (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        category TEXT,
                        description TEXT,
                        status TEXT DEFAULT 'open',
                        created_time DATETIME DEFAULT CURRENT_TIMESTAMP,
                        last_modified_time DATETIME DEFAULT CURRENT_TIMESTAMP,
                        closed_time DATETIME
                    )''')

    # Insert sample data into users table
    cursor.execute("INSERT INTO users (username, password_hash) VALUES ('user1', 'hashed_password')")
    cursor.execute("INSERT INTO users (username, password_hash) VALUES ('staff1', 'hashed_password')")

    conn.commit()
    conn.close()

if __name__ == "__main__":
    main()
