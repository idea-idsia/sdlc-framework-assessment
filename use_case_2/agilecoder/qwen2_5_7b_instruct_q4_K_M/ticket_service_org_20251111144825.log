import db_manager

def main():
    # Initialize database connection
    db = db_manager.DatabaseManager()
    
    while True:
        print("\nTicket Management System")
        print("1. Add New Ticket")
        print("2. Update Ticket Status")
        print("3. Get Open Tickets")
        print("4. Exit")
        
