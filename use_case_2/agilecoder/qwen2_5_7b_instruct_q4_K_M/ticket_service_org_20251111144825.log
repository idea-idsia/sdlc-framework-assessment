import sqlite3
class MicroserviceAPI:
    def __init__(self):
        self.conn = sqlite3.connect('tickets.db')
    def get_open_tickets(self):
        cursor = self.conn.cursor()
        cursor.execute("SELECT * FROM tickets WHERE status = 'open'")
