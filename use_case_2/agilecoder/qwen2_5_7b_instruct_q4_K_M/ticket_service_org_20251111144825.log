            microservice_api = MicroserviceAPI(db_manager)
            print(microservice_api.get_open_tickets_in_period())
        elif choice == 4:
            microservice_api = MicroserviceAPI(db_manager)
            print(microservice_api.average_ticket_resolution_time_by_month())
        elif choice == 5:
